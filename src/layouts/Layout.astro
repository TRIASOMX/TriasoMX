---
import "../styles/global.css";
import Footer from "../components/Main/Footer.astro";
import Navbar from "../components/Main/Navbar.astro";
import CookieBanner from "../components/AboutPages/Banner/CookieBanner.astro";
import ReadingProgressBar from "../components/ReadingProgressBar.astro";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
// Imagen OG provisional hasta tener un diseño propio de 1200×630.
import defaultOgImage from "../assets/images/AsphaltPlant/NewBanner.webp";

interface Props {
  title?: string;
  description?: string;
  /** Import de astro:assets o ruta dentro de /public. */
  image?: ImageMetadata | string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title = "TRIASOUS",
  description = "Fabricante mexicano de plantas de asfalto y equipos para la construcción de carreteras: duraderos, eficientes y de alto rendimiento.",
  image = defaultOgImage,
  type = "website",
  noindex = false,
} = Astro.props;

// Sin slash final, igual que los enlaces internos.
const canonical = new URL(
  Astro.url.pathname.replace(/\/$/, "") || "/",
  Astro.site,
);

const og =
  typeof image === "string"
    ? { url: new URL(image, Astro.site).href, width: undefined, height: undefined }
    : await getImage({
        src: image,
        width: 1200,
        height: 630,
        fit: "cover",
        format: "jpg",
      }).then((img) => ({
        url: new URL(img.src, Astro.site).href,
        width: 1200,
        height: 630,
      }));
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }
    <!-- Mismo valor que --azul-bg1 (blueMain); <meta> no admite var() -->
    <meta name="theme-color" content="#14427c" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="TRIASO" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og.url} />
    {og.width && <meta property="og:image:width" content={String(og.width)} />}
    {og.height && <meta property="og:image:height" content={String(og.height)} />}
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.url} />
  </head>
  <body class="flex flex-col bg-bgMain">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-blueMain focus:shadow-lg focus:ring-2 focus:ring-blueMain"
    >
      Saltar al contenido
    </a>
    <ReadingProgressBar />
    <Navbar />
    <main id="main" tabindex="-1" class="flex-grow focus:outline-none">
      <slot />
      <!-- Aquí se inyectará el contenido de las páginas -->
      <CookieBanner />
    </main>
    <Footer />
  </body>

  <script>
    import {
      loadConsentedScripts,
      onConsentAccepted,
    } from "../components/AboutPages/Banner/Consent";
    import { trackedScripts } from "../components/AboutPages/Banner/Trackedscripts";

    loadConsentedScripts(trackedScripts);

    onConsentAccepted(trackedScripts);
  </script>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background: #f4f5f6;
  }
</style>
