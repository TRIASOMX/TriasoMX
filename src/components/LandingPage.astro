---
import InfoSection from "./LandinPage/InfoSection.astro";
import MainSection from "./LandinPage/MainSection.astro";
import MapaSection from "./LandinPage/MapaSection.astro";
import ItemsSliderLarge from "./LandinPage/ItemsSliderLarge";
import TriasoOSSection from "./LandinPage/TriasoOSSection.astro";
import StackedInfoCards from "./unitComponents/StackedInfoCards.astro";
import ImageAnimationLanding from "./LandinPage/ImageAnimationLanding.astro";
import FAQSection from "./unitComponents/FAQSection.astro";

const images1 = [
  {
    src: "/Gallery/5.svg",
    title: "Vida útil prolongada y económica",
    texto:
      "Rentable, de gran durabilidad, fabricado con materiales de primera calidad y sometido a un estricto control de calidad.",
  },
  {
    src: "/Gallery/6.svg",
    title: "Requiere poco mantenimiento",
    texto:
      "Requiere un mantenimiento mínimo, lo que garantiza su fiabilidad a largo plazo.",
  },
  {
    src: "/Gallery/7.svg",
    title: "Normativa de construcción",
    texto:
      "Cumple con todas las normas y reglamentos de construcción pertinentes de los Estados Unidos Mexicanos.",
  },
  {
    src: "/Gallery/8.svg",
    title: "Rentable",
    texto:
      "Reduzca el tiempo de inactividad, los costos de reubicación y el mantenimiento gracias a un diseño eficiente y un rendimiento confiable.",
  },
  {
    src: "/Gallery/9.svg",
    title: "Alta productividad",
    texto:
      "Aprovechamiento de la capacidad máxima de sus componentes y equilibrio entre ellos para evitar cuellos de botella y lograr una alta eficiencia.",
  },
  {
    src: "/Gallery/10.svg",
    title: "Muy fácil de transportar",
    texto:
      "Fácil de transportar y reubicar, lo que permite ahorrar tiempo y costes; ideal tanto para obras múltiples como para operaciones fijas",
  },
  {
    src: "/Gallery/11.svg",
    title: "Mejora de la imagen de la empresa",
    texto:
      "La estética industrial realza el atractivo visual de sus instalaciones.",
  },
  {
    src: "/Gallery/12.svg",
    title: "Personalizable",
    texto:
      "Adaptamos las funciones para que se ajusten a los requisitos específicos de su proyecto y a sus objetivos operativos.",
  },
];

const cards = [
  {
    title: "Atención técnica inmediata de fábrica",
    text: "",
    bg: "#14427c",
    textColor: "#ffffff",
  },
  {
    title: "Técnicos de fabrica para asistencia inmediata",
    text: "",
    bg: "#595959",
    textColor: "#ffffff",
  },
  {
    title: "Refacciones de entrega inmediata",
    text: "",
    bg: "#ca1c1c",
    textColor: "#ffffff",
  },
  {
    title: "Soporte postventa de fábrica continuo, cercano e inmediato",
    text: "",
    bg: "#00840d",
    textColor: "#ffffff",
  },
];
const faqs = [
  {
    question: "¿Triaso ofrece instalación y puesta en marcha?",
    answer:
      "Sí. Triaso ofrece asistencia para la instalación y puesta en marcha de sus equipos para asegurar su correcta integración y funcionamiento.",
  },
  {
    question: "¿Ofrecen capacitación para los operadores?",
    answer:
      "Sí. Triaso brinda capacitación para que los operadores conozcan el funcionamiento, operación y supervisión de los equipos y del sistema de automatización.",
  },
  {
    question: "¿Triaso ofrece soporte técnico después de la instalación?",
    answer:
      "Sí. Triaso ofrece soporte técnico para atender necesidades relacionadas con la operación, mantenimiento y funcionamiento de los equipos después de su puesta en marcha.",
  },
  {
    question: "¿Puedo comprar refacciones directamente con Triaso?",
    answer:
      "Sí. Triaso suministra refacciones para sus equipos y puede ayudar a identificar los componentes necesarios de acuerdo con el modelo y configuración de la planta.",
  },
  {
    question: "¿Triaso fabrica equipos individuales además de plantas completas?",
    answer:
      "Sí. Además de plantas completas, Triaso fabrica equipos individuales que pueden integrarse a instalaciones nuevas o existentes.",
  },
  {
    question: "¿Triaso puede modernizar o ampliar una planta existente?",
    answer:
      "Sí. Dependiendo de las características de la planta, Triaso puede desarrollar soluciones para modernizar, ampliar o incorporar nuevos equipos y sistemas.",
  },
  {
    question: "¿Puedo visitar una planta Triaso en operación antes de comprar?",
    answer:
      "Es posible coordinar visitas a instalaciones de referencia, sujeto a disponibilidad, ubicación y autorización del propietario de la planta. Consulte con nuestro equipo comercial para conocer las opciones disponibles.",
  },
];
---

<div class="w-full">
  <MainSection />
  <MapaSection />
  <InfoSection />

  <TriasoOSSection />
  <ImageAnimationLanding />

  <div class="w-full bg-[#ca1c1c] my-10">
    <div class="flex justify-center items-center py-6 md:py-10">
      <h2 class="font-bold text-white text-xl md:text-4xl">
        ¡Apostemos por México!
      </h2>
    </div>
  </div>

  <StackedInfoCards
    cards={cards}
    mainTitle="Con nosotros, al ser de México usted tiene muchas ventajas, entre otras: "
    mainDescription="Cuidando así lo que más importa, menor tiempo de inactividad de su equipo."
  />

  <section class="py-10">
    <ItemsSliderLarge images={images1} client:only />
  </section>

  <section
    class="relative w-full h-[500px] md:h-[600px] bg-[url(/delivery1.webp)] bg-cover bg-bottom"
  >
    <div
      class="absolute inset-0 bg-gradient-to-r from-black via-black/50 to-transparent"
    >
    </div>

    <div class="relative z-10 h-full max-w-7xl px-8 mx-auto flex items-center">
      <div class="text-white">
        <h2 class="text-3xl md:text-5xl font-bold leading-tight">
          Somos expertos en lo que hacemos
        </h2>

        <p class="mt-4 text-lg md:text-2xl font-bold text-[#D9D9D9]">
          Con la experiencia que tenemos con más de 300 plantas <br />
          de asfalto fabricadas hasta inicios de este 2026.
        </p>
      </div>
    </div>
  </section>

  <FAQSection items={faqs} />
</div>
