                  Quemador para calentamiento
                </span>
                <button
                  class="mostrar-mas flex items-center gap-1 text-white/80 text-xs hover:text-white transition-colors"
                  aria-expanded="false"
                >
                  <svg
                    class="chevron w-3 h-3 transition-transform duration-300"
                    viewBox="0 0 12 12"
                    fill="none"
                  >
                    <path
                      d="M2 4l4 4 4-4"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"></path>
                  </svg>
                  mostrar más
                </button>
                <div
                  class="expandible max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out"
                >
                  <p class="text-white/75 text-xs leading-relaxed mt-2">
                    Placeholder
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Second Section -->
      <div
        class="w-full flex flex-col items-center justify-center gap-3 tab-content text-base md:text-lg text-grisT font-bold"
        data-tab-content="tab2"
      >
        <div class="w-full flex justify-center">
          <img src={g2.src} alt="t1" class="w-full h-auto max-w-[600px] px-2" />
        </div>
        <div class="w-full px-4 md:px-10">
          <p class="text-sm lg:text-lg md:text-lg font-normal">
            El calentamiento por fuego directo Triaso® está diseñado para elevar
            la temperatura del asfalto. Un quemador ecológico de bajas emisiones
            NOx se monta directamente en la parte inferior del tanque,
            transfiriendo calor a través de tubo de acero hacia el asfalto. Este
            método proporciona un calentamiento rápido y eficiente, con un
            mínimo de pérdida de energía.
          </p>
        </div>

        <div class="bg-[#1e1e1e] p-4 sm:p-6 md:p-10 rounded-b-2xl w-full">
          <div
            class="card-row flex sm:grid sm:grid-cols-3 gap-3 w-full overflow-x-auto sm:overflow-visible snap-x snap-mandatory scroll-smooth"
            id="cardRow0"
          >
            <!-- Card 1-A -->
            <div
              class="relative rounded-lg overflow-hidden group cursor-pointer snap-center shrink-0 w-[85%] sm:w-full"
              data-card="0-0"
            >
              <div
                class="w-full h-56 sm:h-64 md:h-72 lg:h-80 bg-black/10 flex items-center justify-center"
              >
                <img src={img4.src} alt="" class="w-full h-full object-cover" />
              </div>

              <div
                class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-3"
              >
                <span
                  class="font-bold text-white text-sm uppercase tracking-wide leading-tight mb-2"
                >
                  Línea de transferencia de calor
                </span>
                <button
                  class="mostrar-mas flex items-center gap-1 text-white/80 text-xs hover:text-white transition-colors"
                  aria-expanded="false"
                >
                  <svg
                    class="chevron w-3 h-3 transition-transform duration-300"
                    viewBox="0 0 12 12"
                    fill="none"
                  >
                    <path
                      d="M2 4l4 4 4-4"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"></path>
                  </svg>
                  mostrar más
                </button>
                <div
                  class="expandible max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out"
                >
                  <p class="text-white/75 text-xs leading-relaxed mt-2">
                    Placeholder
                  </p>
                </div>
              </div>
            </div>

            <!-- Card 1-B -->
            <div
              class="relative rounded-lg overflow-hidden group cursor-pointer snap-center shrink-0 w-[85%] sm:w-full"
              data-card="0-1"
            >
              <div
                class="w-full h-56 sm:h-64 md:h-72 lg:h-80 bg-black/10 flex items-center justify-center"
              >
                <img src={img5.src} alt="" class="w-full h-full object-cover" />
              </div>
              <div
                class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-3"
              >
                <span
                  class="font-bold text-white text-sm uppercase tracking-wide leading-tight mb-2"
                >
                  Condensadores de vapor
                </span>
                <button
                  class="mostrar-mas flex items-center gap-1 text-white/80 text-xs hover:text-white transition-colors"
                  aria-expanded="false"
                >
                  <svg
                    class="chevron w-3 h-3 transition-transform duration-300"
                    viewBox="0 0 12 12"
                    fill="none"
                  >
                    <path
                      d="M2 4l4 4 4-4"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"></path>
                  </svg>
                  mostrar más
                </button>
                <div
                  class="expandible max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out"
                >
                  <p class="text-white/75 text-xs leading-relaxed mt-2">
                    Placeholder
                  </p>
                </div>
              </div>
            </div>

            <!-- Card 1-C -->
            <div
              class="relative rounded-lg overflow-hidden group cursor-pointer snap-center shrink-0 w-[85%] sm:w-full"
              data-card="0-2"
            >
              <div
                class="w-full h-56 sm:h-64 md:h-72 lg:h-80 bg-black/10 flex items-center justify-center"
              >
                <img src={img6.src} alt="" class="w-full h-full object-cover" />
              </div>
              <div
                class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-3"
              >
                <span
                  class="font-bold text-white text-sm uppercase tracking-wide leading-tight mb-2"
                >
                  Quemador para calentamiento por fuego directo
                </span>
                <button
                  class="mostrar-mas flex items-center gap-1 text-white/80 text-xs hover:text-white transition-colors"
                  aria-expanded="false"
                >
                  <svg
                    class="chevron w-3 h-3 transition-transform duration-300"
                    viewBox="0 0 12 12"
                    fill="none"
                  >
                    <path
                      d="M2 4l4 4 4-4"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"></path>
                  </svg>
                  mostrar más
                </button>
                <div
                  class="expandible max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out"
                >
                  <p class="text-white/75 text-xs leading-relaxed mt-2">
                    Placeholder
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="w-full flex flex-col justify-center">
    <div class="w-full px-2 md:px-8">
      <GallerySlider client:only slides={storageSlides} visibleThumbs={4} />
    </div>

    <div
      class="flex flex-col justify-center items-center space-y-5 py-5 md:py-20 px-8"
    >
      <div class="flex flex-col justify-center items-center">
        <h1 class="font-bold text-2xl md:text-4xl">
          Triaso le da versatilidad y control total sobre su tanque de asfalto,
        </h1>
        <h1 class="font-bold text-2xl md:text-4xl">
          capacidades, diseño, temperatura, operación y confiabilidad.
        </h1>
      </div>

      <div class="flex flex-col justify-center items-center">
        <p class="font-thin text-base md:text-lg">
          Un estándar tan alto que solo un equipo Triaso comparable puede estar
          al mismo nivel.
        </p>
      </div>
    </div>
    <!-- <OSection /> -->
    <TwoColumnSection
      leftBg="bg-redBg"
      rightBg="bg-blueMain"
      imageSrc={Tred.src}
      imageAlt="Red T icon"
      imageWidth="150px"
    >
      <div slot="left" class="flex flex-col justify-center gap-3">
        <h1 class="text-xl md:text-2xl">Nos adaptamos a su proyecto</h1>
        <p class="text-sm md:text-base lg:text-lg">
          Pueden personalizarse y adaptarse a diferentes requerimientos de
          manejo de materiales, ofreciendo eficiencia y confiabilidad en
          cualquier proyecto.
        </p>
        <Whatsbtn />
      </div>

      <div slot="right" class="flex flex-col justify-center gap-3">
        <h1 class="text-xl md:text-2xl">Servicio al cliente 24/7</h1>
        <p class="text-sm md:text-base lg:text-lg">
          Nuestro equipo está disponible en todo momento, listo para asistirte
          cuando lo necesites, incluso fines de semana y días festivos.
        </p>
        <Whatsbtn />
      </div>
    </TwoColumnSection>
  </section>

  <section class="w-full">
    <div
      class="relative bg-gradient-to-b from-[#f1eeb8] to-white text-center py-10 md:py-20 px-6
              rounded-b-[60%]"
    >
      <h2 class="text-2xl md:text-4xl font-bold mb-4">Agende una reunión</h2>

      <p class="text-sm md:text-base mb-8 max-w-2xl mx-auto">
        Cuéntenos más sobre su proyecto para identificar la solución industrial
        que mejor se ajuste a sus necesidades.
      </p>

      <ScheduleBtn />
    </div>
  </section>

  <style is:global>
    /* Estilos para los tabs activos */
    .tab-button {
      transition:
        background-color 0.25s ease,
        color 0.25s ease,
        border-color 0.25s ease;
      border-bottom: 4px solid transparent;
    }

    .tab-button[aria-selected="true"] {
      background-color: #ffffff;
      color: black;
      border-bottom: 4px solid var(--rojo-btn);
    }

    .tab-button[aria-selected="false"] {
      background-color: transparent;
      color: rgba(255, 255, 255, 0.55);
      font-weight: normal;
    }

    .tab-button:hover:not([aria-selected="true"]) {
      background-color: rgba(255, 255, 255, 0.1);
      color: #ffffff;
    }
  </style>
  <script is:inline>
    (function initTabs() {
      document.querySelectorAll("section[data-tabs]").forEach((tabSection) => {
        const tabButtons = tabSection.querySelectorAll(".tab-button");
        const tabContents = tabSection.querySelectorAll(".tab-content");

        // Ocultar todos menos el primero
        const selectedTab = tabSection.querySelector(
          '.tab-button[aria-selected="true"]',
        );
        const selectedTabId = selectedTab?.getAttribute("data-tab");

        tabContents.forEach((content) => {
          const contentTabId = content.getAttribute("data-tab-content");
          content.classList.toggle("hidden", contentTabId !== selectedTabId);
        });

        tabButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const tabId = button.getAttribute("data-tab");

            tabButtons.forEach((btn) =>
              btn.setAttribute("aria-selected", "false"),
            );
            button.setAttribute("aria-selected", "true");

            tabContents.forEach((content) => {
              content.classList.add("hidden");
            });

            const activeContent = tabSection.querySelector(
              `.tab-content[data-tab-content="${tabId}"]`,
            );
            if (activeContent) activeContent.classList.remove("hidden");
          });
        });
      });
    })();
  </script>
  <script is:inline>
    const openModalBtn = document.getElementById("openModalBtn");
    const closeModalBtn = document.getElementById("closeModalBtn");
    const modalOverlay = document.getElementById("modalOverlay");

    // Abrir modal
    openModalBtn.addEventListener("click", () => {
      modalOverlay.classList.remove("hidden");
    });

    // Cerrar modal
    closeModalBtn.addEventListener("click", () => {
      modalOverlay.classList.add("hidden");
    });

    // Cerrar modal al hacer clic fuera del contenido
    modalOverlay.addEventListener("click", (e) => {
      if (e.target === modalOverlay) {
        modalOverlay.classList.add("hidden");
      }
    });
  </script>

  <script>
    document
      .querySelectorAll<HTMLButtonElement>(".mostrar-mas")
      .forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const expandible = btn.nextElementSibling as HTMLElement;
          const chevron = btn.querySelector(".chevron") as HTMLElement;
          const isOpen =
            expandible.style.maxHeight && expandible.style.maxHeight !== "0px";

          if (isOpen) {
            expandible.style.maxHeight = "0px";
            chevron.style.transform = "rotate(0deg)";
            btn.setAttribute("aria-expanded", "false");
          } else {
            expandible.style.maxHeight = expandible.scrollHeight + "px";
            chevron.style.transform = "rotate(180deg)";
            btn.setAttribute("aria-expanded", "true");
          }
        });
      });
  </script>
</section>
