    .tg-card__head {
      padding-left: 18px;
      padding-right: 18px;
    }
    .tg-cta__inner {
      padding: 34px 24px;
    }
  }
</style>

<script>
  (function () {
    "use strict";

    var sections = Array.prototype.slice.call(
      document.querySelectorAll(".tg-sec[id]"),
    );
    var tocLinks = Array.prototype.slice.call(
      document.querySelectorAll(".tg-toc__link"),
    );
    var mLinks = Array.prototype.slice.call(
      document.querySelectorAll(".tg-msheet__link"),
    );
    var curK = document.querySelector(".tg-mobilebar__cur .tg-k");
    var curT = document.querySelector(".tg-mobilebar__cur .tg-t");

    function setActive(id: string) {
      tocLinks.concat(mLinks).forEach(function (a) {
        a.classList.toggle("is-active", a.getAttribute("href") === "#" + id);
      });
      var sec = document.getElementById(id);
      if (sec && curT && curK) {
        curK.textContent = sec.getAttribute("data-part") || "";
        curT.textContent =
          sec.getAttribute("data-short") ||
          sec.getAttribute("data-title") ||
          "";
      }
    }

    if ("IntersectionObserver" in window && sections.length) {
      var visible: Record<string, number> = {};
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            visible[e.target.id] = e.isIntersecting ? e.intersectionRatio : 0;
          });
          var bestId = null,
            best = -1;
          sections.forEach(function (s) {
            var r = visible[s.id] || 0;
            if (r > best) {
              best = r;
              bestId = s.id;
            }
          });
          if (best <= 0) {
            var mid = window.innerHeight * 0.35,
              pick = null;
            sections.forEach(function (s) {
              if (s.getBoundingClientRect().top - mid < 0) pick = s.id;
            });
            bestId = pick || sections[0].id;
          }
          if (bestId) setActive(bestId);
        },
        { rootMargin: "-15% 0px -55% 0px", threshold: [0, 0.15, 0.4, 0.75, 1] },
      );
      sections.forEach(function (s) {
        io.observe(s);
      });
    }

    var sheet = document.querySelector(".tg-msheet");
    var openBtn = document.querySelector(".tg-mobilebar__btn");
    var closeBtn = document.querySelector(".tg-msheet__x");
    function openSheet() {
      if (sheet) {
        sheet.classList.add("open");
        document.body.style.overflow = "hidden";
      }
    }
    function closeSheet() {
      if (sheet) {
        sheet.classList.remove("open");
        document.body.style.overflow = "";
      }
    }
    if (openBtn) openBtn.addEventListener("click", openSheet);
    if (closeBtn) closeBtn.addEventListener("click", closeSheet);
    if (sheet)
      sheet.addEventListener("click", function (e) {
        if (e.target === sheet) closeSheet();
      });
    mLinks.forEach(function (a) {
      a.addEventListener("click", function () {
        setTimeout(closeSheet, 120);
      });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeSheet();
    });

    var revs = Array.prototype.slice.call(
      document.querySelectorAll(".tg-reveal"),
    );
    if ("IntersectionObserver" in window) {
      var ro = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              ro.unobserve(e.target);
            }
          });
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.06 },
      );
      revs.forEach(function (el) {
        ro.observe(el);
      });
    } else {
      revs.forEach(function (el) {
        el.classList.add("in");
      });
    }
  })();
</script>
