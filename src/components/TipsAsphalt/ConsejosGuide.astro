                >
                  {s.title}
                </a>
              ))}
          </>
        ))
      }
    </div>
  </div>
</div>

<style is:global>
  /* ============ Guía "Algunos consejos" — alineada a la marca ============ */
  .tips-guide {
    --tg-azul: var(--azul-bg1);
    --tg-azul-2: var(--azul-bg2);
    --tg-azul-deep: var(--azul-bg1Hover);
    --tg-rojo: var(--rojo-btn);
    --tg-rojo-hover: var(--rojo-btnHover);

    --tg-titulo: var(--gris-titulos);
    --tg-texto: var(--gris-textos5);
    --tg-texto-2: var(--gris-textos4);
    --tg-mute: var(--gris-textos);

    --tg-bg: var(--bg-main);
    --tg-beige: var(--bg-beige);
    --tg-blanco: #ffffff;

    --tg-linea: color-mix(in srgb, var(--gris-titulos) 12%, #fff);
    --tg-linea-2: color-mix(in srgb, var(--gris-titulos) 8%, #fff);
    --tg-azul-tint: color-mix(in srgb, var(--azul-bg1) 8%, #fff);
    --tg-azul-line: color-mix(in srgb, var(--azul-bg1) 22%, #fff);
    --tg-rojo-tint: color-mix(in srgb, var(--rojo-btn) 7%, #fff);
    --tg-rojo-line: color-mix(in srgb, var(--rojo-btn) 25%, #fff);

    --tg-maxw: 1240px;
    --tg-shadow-md:
      0 4px 18px -6px rgba(20, 40, 75, 0.16),
      0 2px 6px -2px rgba(20, 40, 75, 0.08);
    --tg-r: 14px;
    --tg-r-sm: 10px;

    background: var(--tg-bg);
    color: var(--tg-texto);
    font-size: 16px;
    line-height: 1.62;
  }
  .tips-guide h1,
  .tips-guide h2,
  .tips-guide h3,
  .tips-guide h4,
  .tips-guide h5 {
    margin: 0;
  }
  .tips-guide p {
    margin: 0;
  }
  .tips-guide a {
    color: inherit;
  }
  .tips-guide *,
  .tg-mobilebar *,
  .tg-msheet * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  .tg-sec,
  .tg-part {
    scroll-margin-top: 96px;
  }

  /* ---------- Hero ---------- */
  .tg-hero {
    background: var(--tg-blanco);
    border-bottom: 1px solid var(--tg-linea);
  }
  .tg-hero__inner {
    max-width: var(--tg-maxw);
    margin: 0 auto;
    padding: 124px 32px 56px;
  }
  .tg-hero__kicker {
    display: inline-block;
    margin-bottom: 16px;
  }
  .tg-hero__rule {
    display: flex;
    margin: 22px 0;
  }
  .tg-hero__rule span {
    height: 3px;
    width: 88px;
  }
  .tg-hero__rule span:first-child {
    background: var(--tg-rojo);
  }
  .tg-hero__rule span:last-child {
    background: color-mix(in srgb, var(--gris-titulos) 18%, #fff);
  }
  .tg-hero__lead {
    margin-top: 0;
  }
  .tg-hero__criterio {
    margin-top: 14px;
  }
  .tg-hero__meta {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .tg-partbtn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border: 1px solid var(--tg-linea);
    border-radius: 10px;
    background: var(--tg-bg);
    text-decoration: none;
    transition:
      border-color 0.18s ease,
      color 0.18s ease;
  }
  .tg-partbtn:hover {
    border-color: var(--tg-azul);
    color: var(--tg-azul);
  }

  /* ---------- Shell ---------- */
  .tg-shell {
    max-width: var(--tg-maxw);
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 268px minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }

  /* ---------- TOC ---------- */
  .tg-toc {
    position: sticky;
    top: 84px;
    align-self: start;
    padding-top: 46px;
    max-height: calc(100vh - 96px);
    overflow-y: auto;
