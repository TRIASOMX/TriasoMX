---

<div class="tips-guide">
  <!-- ===== Hero ===== -->
  <header class="tg-hero">
    <div class="tg-hero__inner">
      <span class="tg-hero__kicker text-sm font-semibold text-blueMain"
        >Guía de compra · Triaso</span
      >
      <h1
        class="max-w-[34ch] text-3xl font-bold text-grisT sm:text-4xl md:text-5xl uppercase"
      >
        Algunos consejos para comprar una planta de asfalto
      </h1>
      <div class="tg-hero__rule" aria-hidden="true">
        <span></span><span></span>
      </div>
      <p
        class="tg-hero__lead max-w-2xl text-base leading-relaxed text-grisP md:text-lg"
      >
        La compra de una planta de asfalto es una inversión significativa y
        constituye la base de un negocio de producción de mezcla asfáltica.
      </p>
      <p class="tg-hero__criterio text-base font-bold text-grisT">
        Compre con criterio.
      </p>
      <nav class="tg-hero__meta">
        {
          parts.map((pt, i) => (
            <a href={`#${pt.id}`} class="tg-partbtn text-grisPPP">
              <span class="tg-partbtn__n text-xs font-extrabold text-blueMain">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="tg-partbtn__t text-sm font-semibold">
                {pt.title}
              </span>
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <!-- ===== Barra móvil ===== -->
  <div class="tg-mobilebar">
    <div class="tg-mobilebar__row">
      <div class="tg-mobilebar__cur">
        <span class="tg-k block text-[10px] uppercase tracking-wide text-grisP"
          >Guía de compra</span
        >
        <span class="tg-t block truncate text-sm font-bold text-blueMain"
          >Algunos consejos</span
        >
      </div>
      <button
        class="tg-mobilebar__btn text-[13px] font-bold"
        type="button"
        aria-label="Abrir índice"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"></path></svg
        >
        Secciones
      </button>
    </div>
  </div>

  <div class="tg-shell">
    <!-- ===== TOC escritorio ===== -->
    <aside class="tg-toc">
      <div class="tg-toc__label text-[11px] uppercase tracking-wide text-grisP">
        En esta guía
      </div>
      <nav>
        {
          parts.map((pt) => (
            <>
              <a
                class="tg-toc__part text-xs font-bold uppercase text-blueMain"
                href={`#${pt.id}`}
              >
                {pt.title}
              </a>
              {sections
                .filter((s) => s.pid === pt.id)
                .map((s) => (
                  <a
                    class="tg-toc__link text-sm leading-snug text-grisPPP"
                    href={`#${s.id}`}
                  >
                    {s.title}
                  </a>
                ))}
            </>
          ))
        }
      </nav>
    </aside>

    <!-- ===== Contenido ===== -->
    <main class="tg-content">
      {
        parts.map((pt) => (
          <div class="tg-part" id={pt.id}>
            <div class="tg-part__head">
              <span class="tg-part__num block text-[13px] font-semibold uppercase tracking-wide text-grisP">
                {pt.num}
              </span>
              <h2 class="tg-part__title text-2xl font-bold uppercase tracking-tight text-grisT md:text-4xl">
                {pt.title}
              </h2>
              {pt.blurb.length > 0 && (
                <p class="tg-part__blurb max-w-[62ch] text-base text-grisPPP">
                  {pt.blurb.map((b) => (
                    <span>{b}</span>
                  ))}
                </p>
              )}
            </div>

            {sections
              .filter((s) => s.pid === pt.id)
              .map((s) => (
                <section
                  class="tg-sec"
                  id={s.id}
                  data-part={s.part}
                  data-short={s.short}
                  data-title={s.title}
                >
                  <div class="tg-sec__head">
                    <div class="tg-sec__icon" set:html={s.icon} />
                    <div class="tg-sec__titles">
                      <div class="tg-sec__kicker text-[11px] uppercase tracking-wide text-grisP">
                        {s.part}
                      </div>
                      <h2 class="tg-sec__title text-xl font-bold tracking-tight text-blueMain md:text-2xl">
                        {s.title}
                      </h2>
                    </div>
                  </div>

                  {s.intros.map((p) => (
                    <p class="tg-sec__intro mt-1.5 max-w-[70ch] text-base leading-relaxed text-gris5 md:text-lg">
                      {p}
                    </p>
                  ))}

                  <div
                    class={`tg-evaluar tg-reveal${s.evaluarBlue ? " tg-evaluar--blue" : ""}`}
                  >
                    <div
                      class="tg-evaluar__tag text-[11px] uppercase tracking-wide text-blueMainHover"
                      set:html={ICO.tag + esc(s.evaluarTag ?? "Qué evaluar")}
                    />
                    <div class="tg-evaluar__h mb-3.5 text-lg font-bold leading-snug text-grisT">
                      {s.evaluarH}
                    </div>
                    <Fragment set:html={renderChecks(s.checks)} />
                  </div>

                  {s.note && (
                    <div class="tg-noteblock tg-reveal">
                      <h4 class="mb-3.5 text-lg font-bold text-blueMain">
                        {s.note.h}
                      </h4>
                      <Fragment set:html={renderChecks(s.note.checks)} />
                    </div>
                  )}

                  {(s.risk || s.ok) && (
                    <div
                      class="tg-cmp tg-reveal"
                      set:html={
                        (s.risk
                          ? card(
                              "risk",
                              s.riskTitle ?? RISK_TITLE,
                              s.riskSub ?? RISK_SUB,
                              undefined,
                              s.risk,
                            )
                          : "") +
                        (s.ok
                          ? card("ok", OK_TITLE, OK_SUB, s.okLead, s.ok)
                          : "")
                      }
                    />
                  )}

                  {s.tech && (
                    <div class="tg-tech tg-reveal">
                      <div class="tg-tech__tag text-[11px] uppercase tracking-wide text-grisP">
                        {s.tech.tag}
                      </div>
                      <div class="tg-tech__grid">
                        {s.tech.cols.map((c) => (
                          <div class="tg-tech__col">
                            <h5 class="text-base font-bold text-blueMain">
                              {c.h}
                            </h5>
                            <ul>
                              {c.items.map((i) => (
                                <li class="text-sm text-gris5">{i}</li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {s.quote && (
                    <div class="tg-quote tg-reveal">
                      <p class="text-lg font-semibold leading-snug md:text-xl">
                        {s.quote.text}
                      </p>
                      <span class="tg-cite mt-3 block text-xs uppercase tracking-wide">
                        {s.quote.cite}
                      </span>
                    </div>
                  )}
                </section>
              ))}
          </div>
        ))
      }

      <!-- ===== CTA ===== -->
      <section class="tg-cta tg-reveal">
        <Image
          src={ctaBg}
          alt=""
          widths={[640, 1024, 1600]}
          sizes="(min-width: 1024px) 1024px, 100vw"
          class="tg-cta__bg"
          aria-hidden="true"
        />
        <div class="tg-cta__scrim" aria-hidden="true"></div>
        <div class="tg-cta__inner">
          <h3
            class="max-w-[20ch] text-2xl font-bold uppercase tracking-tight text-white md:text-3xl"
          >
            Inclúyanos en su proceso de evaluación
          </h3>
          <p class="mt-3.5 max-w-[52ch] text-base leading-relaxed text-white/90">
            Visite nuestras plantas operando en México y verifique cada
            afirmación directamente con nuestros ingenieros y técnicos, sin
            intermediarios.
          </p>
          <div class="tg-cta__btns">
            <a
              class="group inline-flex w-full items-center justify-center gap-2 rounded-full border-2 border-redBg bg-redBg px-7 py-2.5 text-sm font-semibold text-white transition-all duration-300 ease-out hover:scale-[1.03] hover:border-white hover:bg-white hover:text-redBg hover:shadow-lg sm:w-auto"
              href="/Contact"
            >
              Visita nuestras plantas
              <svg
                class="h-[18px] w-[18px] transition-transform duration-300 group-hover:translate-x-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
              >
            </a>
            <a
              class="inline-flex w-full items-center justify-center rounded-full border-2 border-white/80 px-7 py-2.5 text-sm font-semibold text-white transition-all duration-300 ease-out hover:scale-[1.03] hover:bg-white hover:text-grisT hover:shadow-lg sm:w-auto"
              href="/Contact">Contáctanos</a
            >
          </div>
        </div>
      </section>
    </main>
  </div>

  <p class="tg-endnote mx-auto max-w-[1240px] text-center text-xs text-grisP">
    Triaso — Algunos consejos para comprar una planta de asfalto · Compre con
