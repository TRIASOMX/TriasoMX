};

function esc(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

const SUB_LI = "text-sm text-grisPPP";

function renderPlain(nodes: Node[]): string {
  return (
    "<ul>" +
    nodes
      .map((n) =>
        typeof n === "string"
          ? `<li class="${SUB_LI}">${esc(n)}</li>`
          : `<li class="${SUB_LI}">${esc(n.t)}${n.sub ? renderPlain(n.sub) : ""}</li>`,
      )
      .join("") +
    "</ul>"
  );
}

function renderChecks(nodes: Node[]): string {
  return (
    '<ul class="tg-checks">' +
    nodes
      .map((n) =>
        typeof n === "string"
          ? `<li class="text-base text-gris5">${esc(n)}</li>`
          : `<li class="text-base text-gris5">${esc(n.t)}${n.sub ? renderPlain(n.sub) : ""}</li>`,
      )
      .join("") +
    "</ul>"
  );
}

function renderItems(nodes: Node[], kind: "x" | "c"): string {
  const mk = kind === "x" ? ICO.x : ICO.c;
  return (
    '<ul class="tg-items">' +
    nodes
      .map((n) => {
        const t = typeof n === "string" ? n : n.t;
        const sub = typeof n !== "string" && n.sub ? renderPlain(n.sub) : "";
        return `<li class="text-sm leading-relaxed text-gris5">${mk}${esc(t)}${sub}</li>`;
      })
      .join("") +
    "</ul>"
  );
}

function card(
  kind: "risk" | "ok",
  title: string,
  sub: string,
  lead: string | undefined,
  nodes: Node[],
): string {
  const badge = kind === "risk" ? ICO.warn : ICO.shield;
  return `<div class="tg-card tg-card--${kind}">
    <div class="tg-card__head"><span class="tg-badge">${badge}</span>
      <div><h4 class="text-base font-bold">${esc(title)}</h4><span class="tg-sub text-[10px] uppercase tracking-wide">${esc(sub)}</span></div></div>
    <div class="tg-card__body">${lead ? `<p class="tg-card__lead text-sm text-grisPPP">${esc(lead)}</p>` : ""}${renderItems(nodes, kind === "risk" ? "x" : "c")}</div>
  </div>`;
}

