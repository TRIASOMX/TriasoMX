  .tg-sec__intro + .tg-sec__intro {
    margin-top: 10px;
  }

  /* "Qué evaluar" */
  .tg-evaluar {
    margin-top: 24px;
    background: var(--tg-azul-tint);
    border: 1px solid var(--tg-azul-line);
    border-left: 3px solid var(--tg-azul);
    border-radius: var(--tg-r);
    padding: 22px 26px;
  }
  .tg-evaluar__tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }
  .tg-evaluar__tag svg {
    width: 14px;
    height: 14px;
  }
  .tg-checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .tg-checks > li {
    position: relative;
    padding-left: 30px;
  }
  .tg-checks > li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 2px;
    width: 19px;
    height: 19px;
    border-radius: 5px;
    background: #fff;
    border: 1.5px solid var(--tg-azul);
  }
  .tg-checks > li::after {
    content: "";
    position: absolute;
    left: 6px;
    top: 6px;
    width: 7px;
    height: 4px;
    border-left: 2px solid var(--tg-azul);
    border-bottom: 2px solid var(--tg-azul);
    transform: rotate(-45deg);
  }
  .tg-checks ul {
    list-style: none;
    margin: 8px 0 0;
    padding-left: 4px;
    display: grid;
    gap: 6px;
  }
  .tg-checks ul li {
    position: relative;
    padding-left: 18px;
  }
  .tg-checks ul li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 9px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--tg-azul);
