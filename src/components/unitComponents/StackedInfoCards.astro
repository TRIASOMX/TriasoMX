---
type CardData = {
  title: string;
  text: string;
  bg: string;
  textColor: string;
};

export interface Props {
  cards: CardData[];
  mainTitle: string | string[];
  mainDescription: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  cards = [],
  mainTitle,
  mainDescription,
  imageSrc: _imageSrc,
  imageAlt: _imageAlt = "Persistent image",
} = Astro.props;

const titleLines = Array.isArray(mainTitle) ? mainTitle : [mainTitle];
---

<section
  class="stack-section bg-neutral-100 flex flex-row justify-center items-center min-h-[calc(100vh-4rem)]"
>
  <div
    class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-8 md:gap-12 lg:gap-20 items-center w-full"
  >
    <div class="left-content text-center lg:text-left">
      <h2
        class="text-3xl md:text-[60px] font-extrabold leading-tight tracking-tighter"
      >
        {titleLines.map((line) => <span class="block">{line}</span>)}
      </h2>
      <div class="w-1/2 h-1 bg-[#ca1c1c] my-5 mx-auto lg:mx-0"></div>
      <p class="text-black w-full text-base md:text-2xl">
        {mainDescription}
      </p>
    </div>

    <div
      class="cards-wrapper relative h-[460px] sm:h-[500px] md:h-[520px] lg:h-[600px] overflow-hidden"
    >
      {
        cards.map((card: CardData) => (
          <div
            class="stack-card absolute w-full max-w-lg mx-auto left-0 right-0 top-0 md:top-[4%] lg:top-[30%] lg:left-auto rounded-xl p-8 md:p-10 shadow-xl"
            style={`background:${card.bg}; color:${card.textColor}`}
          >
            <h3 class="text-2xl md:text-3xl font-semibold mb-4">
              {card.title}
            </h3>
            <p class="text-base opacity-90 leading-relaxed">{card.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll<HTMLElement>(".stack-section");

    sections.forEach((section) => {
      const wrapper = section.querySelector<HTMLElement>(".cards-wrapper");
      const cards = Array.from(
        section.querySelectorAll<HTMLElement>(".stack-card"),
      );

      if (!wrapper || cards.length === 0) return;

      gsap.set(cards, {
        y: (i: number) => (i === 0 ? 0 : wrapper.offsetHeight + 10),
        zIndex: (i: number) => i,
        transformOrigin: "top center",
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              initAnimation(section, cards);
              observer.disconnect();
            }
          });
        },
        { threshold: 0.1 },
      );

      observer.observe(section);
    });
  });

  function initAnimation(section: HTMLElement, cards: HTMLElement[]) {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top top+=64",
        end: `+=${cards.length * 400}`,
        scrub: 0.8,
        pin: true,
        pinSpacing: true,
        anticipatePin: 1,
      },
    });

    cards.forEach((card: HTMLElement, i: number) => {
      if (i === 0) return;

      tl.to(
        card,
        {
          y: i * 20,
          duration: 1,
          ease: "power3.out",
        },
        i,
      );

      for (let j = 0; j < i; j++) {
        tl.to(
          cards[j],
          {
            scale: 1 - (i - j) * 0.04,
            y: j * 20 - (i - j) * 10,
            duration: 1,
            ease: "power3.out",
          },
          i,
        );
      }
    });
  }
</script>
