---
interface Props {
  title: string;
  text: string;
  heroImage: string;
}
const { title, text, heroImage } = Astro.props as Props;
---

<section
  class="w-full mt-20 h-auto md:h-[100vh] flex flex-col justify-start items-start md:justify-center md:items-center gap-5 md:gap-10"
>
  <div class="w-full h-[50%] flex justify-center items-end relative">
    <div class="absolute inset-0 h-[70%]">
      <div class="w-full h-[60%]"></div>
      <div
        class="bg-gradient-to-t from-black/50 via-black/30 to-transparent h-[30%]"
      >
      </div>
    </div>
    <img
      src={heroImage}
      alt="Hero Image"
      class="z-10 w-[80%] h-auto md:w-auto md:h-full md:max-w-[800px] object-contain"
    />
  </div>
  <div class="w-full h-[50%] text-center">
    <h1 class="text-black text-2xl md:text-5xl font-bold max-w-[30ch] mx-auto">
      {title}
    </h1><br />
    <p class="text-gray-700 text-sm md:text-xl max-w-[100ch] mx-auto">{text}</p>
  </div>
</section>
