---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import CotizarCompararBtns from "./CotizarCompararBtns.astro";
interface Props {
  title: string;
  text: string;
  heroImage: string | ImageMetadata;
  btns?: boolean;
  titleColor?: string;
  textColor?: string;
  bgColor?: string;
}
const {
  title,
  text,
  heroImage,
  btns,
  titleColor = "black",
  textColor = "#374151",
  bgColor,
} = Astro.props as Props;

const isOptimizedImage = typeof heroImage === "object";
const heroImgClass =
  "z-10 w-[80%] h-auto md:w-auto md:h-full md:max-w-[800px] object-contain";
---

<section
  class="w-full h-auto md:h-[90vh] flex flex-col justify-center items-center md:justify-center md:items-center gap-5 md:gap-10 pt-20 md:pt-0 mb-6"
  style={bgColor ? { backgroundColor: bgColor } : undefined}
>
  <div class="w-full h-[50%] flex justify-center items-end relative">
    <div class="absolute inset-0 h-[75%]">
      <div class="w-full h-[60%]"></div>
      <div
        class="bg-gradient-to-t from-gray-400/50 via-gray-400/30 to-transparent h-[40%]"
      >
      </div>
    </div>
    {
      isOptimizedImage ? (
        <Image
          src={heroImage as ImageMetadata}
          alt="Hero Image"
          class={heroImgClass}
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <img
          src={heroImage as string}
          alt="Hero Image"
          class={heroImgClass}
          loading="eager"
          fetchpriority="high"
        />
      )
    }
  </div>
  <slot />
  <div class="w-full h-[50%] text-center flex flex-col justify-center">
    <h1
      class="text-2xl md:text-5xl font-bold max-w-[35ch] mx-auto uppercase"
      style={{ color: titleColor }}
    >
      {title}
    </h1><br />
    <p
      class="text-sm md:text-xl max-w-[150ch] mx-auto px-8"
      style={{ color: textColor }}
    >
      {text}
    </p>
    <!--SLOT HERE -->

    {
      btns ? (
        <br/>
        <CotizarCompararBtns cotizarHref="/Contact" compararHref="#" />
      ) : (
        ""
      )
    }
  </div>
</section>
