---
export interface Props {
  text?: string;
  href?: string;
  className?: string;
}

const { text = "Ver horarios disponibles", href, className = "" } =
  Astro.props;

const baseClass = `border border-black px-4 py-2 text-sm md:px-6 md:py-3 md:text-base rounded-full hover:bg-black hover:text-white transition ${className}`;
---

{
  href ? (
    <a href={href} class={`inline-block ${baseClass}`}>
      {text}
    </a>
  ) : (
    <button class={baseClass}>{text}</button>
  )
}
