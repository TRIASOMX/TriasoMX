---
interface Props {
  image: string;
  title: string;
  description: string;
}
const { image, title, description } = Astro.props;
---

<div
  class="feature-card relative rounded-lg overflow-hidden group cursor-pointer min-w-[250px] md:min-w-[450px]"
>
  <div class="w-full h-56 sm:h-80 lg:h-96 bg-black/10 overflow-hidden">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>
  <div
    class="dark-overlay absolute inset-0 bg-gradient-to-t from-black/95 via-black/50 to-transparent opacity-0 transition-opacity duration-300 pointer-events-none"
  >
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-3 sm:p-4"
  >
    <span
      class="font-bold text-white text-sm sm:text-base uppercase tracking-wide leading-tight mb-2"
    >
      {title}
    </span>
    <button
      class="mostrar-queso flex items-center gap-1 text-white/80 text-xs hover:text-white transition-colors"
      aria-expanded="false"
      type="button"
    >
      <svg
        class="chevron w-3 h-3 transition-transform duration-300"
        viewBox="0 0 12 12"
        fill="none"
      >
        <path
          d="M2 4l4 4 4-4"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"></path>
      </svg>
      mostrar más
    </button>
    <div
      class="expandible max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out"
    >
      <p class="text-white/75 text-xs leading-relaxed mt-2">
        {description}
      </p>
    </div>
  </div>
</div>

<script>
  function initCards() {
    document.querySelectorAll<HTMLElement>(".mostrar-queso").forEach((btn) => {
      if (btn.dataset.hasListener) return;
      btn.dataset.hasListener = "true";

      btn.addEventListener("click", (e) => {
        e.stopPropagation();

        const expandible = btn.nextElementSibling as HTMLElement;
        const chevron = btn.querySelector<HTMLElement>(".chevron");
        const card = btn.closest<HTMLElement>(".feature-card");
        const darkOverlay = card?.querySelector<HTMLElement>(".dark-overlay");
        if (!expandible || !chevron) return;

        // Bug fix: aria-expanded es la fuente de verdad, no el style
        const isOpen = btn.getAttribute("aria-expanded") === "true";

        if (isOpen) {
          expandible.style.maxHeight = "0px";
          chevron.style.transform = "rotate(0deg)";
          btn.setAttribute("aria-expanded", "false");
          darkOverlay?.classList.remove("opacity-100");
          darkOverlay?.classList.add("opacity-0");
        } else {
          expandible.style.maxHeight = expandible.scrollHeight + "px";
          chevron.style.transform = "rotate(180deg)";
          btn.setAttribute("aria-expanded", "true");
          darkOverlay?.classList.remove("opacity-0");
          darkOverlay?.classList.add("opacity-100");
        }
      });
    });
  }

  // Ejecución inicial
  initCards();

  // Soporte para Astro View Transitions
  document.addEventListener("astro:page-load", initCards);
</script>
