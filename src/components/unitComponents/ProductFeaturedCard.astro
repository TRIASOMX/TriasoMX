---
// ProductFeatureCards.astro
//
// Componente reutilizable: grid de tarjetas con overlay de texto,
// acordeón "mostrar más" y un slider (solo en móvil) con dots.
// Opcionalmente, una de las tarjetas puede abrir un modal con
// contenido arbitrario (pasado vía slot="modal").
//
// Puede usarse varias veces en la misma página sin conflictos:
// no depende de ningún id fijo, todo el JS se resuelve con
// scoping relativo a cada instancia.

import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export interface FeatureCard {
  image: ImageMetadata;
  imageAlt?: string;
  imageClass?: string;
  title: string;
  description: string;
  /** Si esta tarjeta debe mostrar el botón que abre el modal */
  modalTrigger?: boolean;
  /** Texto del botón que abre el modal (default: "Todos los detalles técnicos") */
  modalButtonLabel?: string;
}

export interface Props {
  cards: FeatureCard[];
  /** Título accesible del modal (para aria-labelledby) */
  modalTitleId?: string;
}

const { cards } = Astro.props;

// Sufijo único por instancia: evita colisiones de id si el
// componente se usa más de una vez en la misma página.
const uid = crypto.randomUUID().slice(0, 8);

const hasModal = cards.some((c) => c.modalTrigger);
---

<section class="bg-[#393939] py-6" data-product-cards-root data-instance={uid}>
  <div class="max-w-7xl mx-auto px-8">
    <div class="relative">
      <div
        class="card-track grid grid-cols-1 lg:grid-cols-3 md:grid-cols-3 gap-3"
      >
        {
          cards.map((card, i) => (
            <div
              class="card-slide relative rounded-lg overflow-hidden cursor-pointer"
              data-card={i}
            >
              <div class="w-full h-80 bg-black/10 flex items-center justify-center">
                <Image
                  src={card.image}
                  alt={card.imageAlt ?? ""}
                  class={card.imageClass}
                />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-3">
                <span class="font-bold text-white text-sm uppercase tracking-wide leading-tight mb-2">
                  {card.title}
                </span>
                <button
                  class="mostrar-mas flex items-center gap-1 text-white/80 text-xs hover:text-white transition-colors"
                  aria-expanded="false"
                >
                  <svg
                    class="chevron w-3 h-3 transition-transform duration-300"
                    viewBox="0 0 12 12"
                    fill="none"
                  >
                    <path
                      d="M2 4l4 4 4-4"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                    />
                  </svg>
                  mostrar más
                </button>
                <div class="expandible max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out">
                  <p class="text-white/75 text-xs leading-relaxed mt-2">
                    {card.description}
                  </p>
                  {card.modalTrigger && (
                    <div class="rounded-2xl border border-white flex justify-center items-center w-1/2 mt-2">
                      <button
                        class="btn-detalles text-white text-xs leading-relaxed py-1 px-3 w-full"
                        aria-haspopup="dialog"
                      >
                        {card.modalButtonLabel ?? "Todos los detalles técnicos"}
                      </button>
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    {
      cards.length > 1 && (
        <div class="dots-wrapper hidden justify-center gap-2 mt-4">
          {cards.map((_, i) => (
            <button
              class="dot w-2 h-2 rounded-full transition-opacity"
              class:list={[i === 0 ? "bg-[#dc2626]" : "bg-white/40"]}
              data-index={i}
              aria-label={`Ir a slide ${i + 1}`}
            />
          ))}
        </div>
      )
    }
  </div>
</section>

{
  hasModal && (
    <div
      class="modal-detalles fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby={`modal-titulo-${uid}-1`}
      data-instance={uid}
    >
      <div class="relative max-w-2xl w-full max-h-[85vh] overflow-y-auto shadow-2xl space-y-5">
        <button
          class="modal-close absolute top-8 right-3 text-gray-400 hover:text-gray-700 transition-colors"
          aria-label="Cerrar modal"
        >
          <svg viewBox="0 0 16 16" fill="none" class="w-5 h-5">
            <path
              d="M2 2l12 12M14 2L2 14"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </svg>
        </button>

        <slot name="modal" />
      </div>
    </div>
  )
}

<style>
  @media (max-width: 767px) {
    .card-track {
      display: flex !important;
      overflow-x: scroll;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 0 !important;
    }
    .card-track::-webkit-scrollbar {
      display: none;
    }
    .card-slide {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }
  }
</style>

<script>
  // Se ejecuta UNA vez por página (Astro deduplica scripts idénticos
  // entre instancias repetidas del componente) e inicializa CADA
  // instancia encontrada de forma independiente. Así, tener el
  // componente varias veces en la misma página nunca causa conflictos.

  function initInstance(root: HTMLElement) {
    // --- Acordeón "mostrar más" (delegado, no un listener por botón) ---
    root.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
        ".mostrar-mas",
      );
      if (!btn || !root.contains(btn)) return;
      e.stopPropagation();

      const expandible = btn.nextElementSibling as HTMLElement;
      const chevron = btn.querySelector(".chevron") as HTMLElement;
      const isOpen =
        expandible.style.maxHeight && expandible.style.maxHeight !== "0px";

      if (isOpen) {
        expandible.style.maxHeight = "0px";
        chevron.style.transform = "rotate(0deg)";
        btn.setAttribute("aria-expanded", "false");
      } else {
        expandible.style.maxHeight = expandible.scrollHeight + "px";
        chevron.style.transform = "rotate(180deg)";
        btn.setAttribute("aria-expanded", "true");
      }
    });

    // --- Slider móvil ---
    const track = root.querySelector<HTMLElement>(".card-track");
    const slides = Array.from(
      root.querySelectorAll<HTMLElement>(".card-slide"),
    );
    const dots = root.querySelectorAll<HTMLButtonElement>(".dot");
    const dotsWrapper = root.querySelector<HTMLElement>(".dots-wrapper");
    const total = slides.length;

    function isMobile() {
      return window.innerWidth < 768;
    }

    function getCurrentIndex(): number {
      if (!track) return 0;
      const slideWidth = track.offsetWidth;
      return slideWidth ? Math.round(track.scrollLeft / slideWidth) : 0;
    }

    function updateDots(index: number) {
      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-[#dc2626]", i === index);
        dot.classList.toggle("bg-white/40", i !== index);
      });
    }

    function goTo(index: number) {
      if (!track) return;
      const clamped = Math.max(0, Math.min(index, total - 1));
      const slideWidth = track.offsetWidth;
      track.scrollTo({ left: clamped * slideWidth, behavior: "smooth" });
    }

    function syncSliderVisibility() {
      if (!dotsWrapper || total <= 1) return;
      if (isMobile()) {
        dotsWrapper.classList.remove("hidden");
        dotsWrapper.classList.add("flex");
      } else {
        dotsWrapper.classList.add("hidden");
        dotsWrapper.classList.remove("flex");
      }
    }

    track?.addEventListener(
      "scroll",
      () => {
        if (isMobile()) updateDots(getCurrentIndex());
      },
      { passive: true },
    );

    dots.forEach((dot) => {
      dot.addEventListener("click", () => goTo(Number(dot.dataset.index)));
    });

    syncSliderVisibility();
    window.addEventListener("resize", syncSliderVisibility);

    // --- Modal (si esta instancia tiene uno) ---
    // El modal vive fuera del <section> (es hermano), así que se
    // empareja con su root vía data-instance, no por proximidad en el DOM.
    const instanceId = root.dataset.instance;
    const modal = document.querySelector<HTMLElement>(
      `.modal-detalles[data-instance="${instanceId}"]`,
    );
    const modalClose = modal?.querySelector<HTMLElement>(".modal-close");
    const btnDetalles = root.querySelector<HTMLElement>(".btn-detalles");

    function openModal() {
      if (!modal) return;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
      modalClose?.focus();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
      btnDetalles?.focus();
    }

    btnDetalles?.addEventListener("click", (e) => {
      e.stopPropagation();
      openModal();
    });

    modalClose?.addEventListener("click", closeModal);

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });
  }

  document
    .querySelectorAll<HTMLElement>("[data-product-cards-root]")
    .forEach(initInstance);
</script>
