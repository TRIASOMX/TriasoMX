---
import { Image } from "astro:assets";
import SlidersCarrusel from "../IntegralAsphalt/SlidersCarrusel";
import ASOdom from "../../assets/images/AsphaltStorage/ASOdo.webp";
import Whatsbtn from "../unitComponents/Whatsbtn.astro";

const images2 = [
  {
    src: "/Gallery/counterflow.webp",
    title: "Tambor mezclador de contraflujo",
    texto: `<span style="color:black">El tambor mezclador de contraflujo</span>, ubicado en el centro del chasis, está diseñado para una transferencia de calor eficiente y una mínima pérdida de finos, asegurando una calidad constante en la mezcla asfáltica. Su construcción robusta y sellado avanzado minimizan la infiltración de aire y reducen el mantenimiento. Diseñado específicamente para la planta de 10 Tph, ofrece un rendimiento confiable en un sistema compacto y rentable.`,
  },
  {
    src: "/Gallery/Caja2.webp",
    title: "Mezclador pugmill externo",
    texto: `<span style="color:black">El mezclador pugmill externo</span>, montado directamente debajo de la salida del tambor, asegura una mezcla final superior del asfalto. Esta etapa adicional garantiza una mezcla más homogénea y constante al integrar completamente los materiales antes de la descarga. Accionado por un motor de 5 hp con una caja reductora robusta, cuenta con paletas intercambiables resistentes al desgaste para una larga vida útil y fácil mantenimiento.`,
  },
  {
    src: "/Gallery/aggregatesbin.webp",
    title: "Tolva de agregados",
    texto: `<span style="color:black">La tolva de agregados</span> está diseñada para almacenar material predosificado listo para la producción de asfalto. Su descarga trapezoidal y operación suave de la banda aseguran un flujo constante y controlado hacia el sistema de secado. Equipada con una polea motriz recubierta para mejorar el agarre de la banda, permite una alimentación constante para mantener una calidad confiable de la mezcla durante todo el proceso.`,
  },
  {
    src: "/Gallery/tank.webp",
    title: "Tanque de asfalto",
    texto: `<span style="color:black">El tanque de asfalto </span>está diseñado para un almacenamiento y calentamiento eficientes, asegurando un suministro constante de asfalto a la temperatura ideal de producción. Con un quemador de 140,000 Btu/hr y agitador integrado, permite un calentamiento rápido y un arranque ágil. Una bomba de 2" con motor de 2 hp asegura un flujo uniforme, optimizando el rendimiento de la planta.`,
  },
  {
    src: "/Gallery/electricgen.webp",
    title: "Generador eléctrico",
    texto: `<span style="color:black">El generador eléctrico </span>proporciona energía constante y confiable para toda la planta de asfalto. Con una capacidad de 20 kW continuos y 22 kW de emergencia, alimenta todos los componentes eléctricos sin interrupciones. Impulsado por un motor diésel Cummins de 35 hp y un tanque de combustible de 110 litros, ofrece mayor autonomía con bajo mantenimiento.`,
  },
  {
    src: "/Gallery/controlgabinet.webp",
    title: "Gabinete de control",
    texto: `<span style="color:black">El gabinete de control </span>centraliza la operación de toda la planta, ofreciendo una gestión intuitiva de todos los componentes clave, desde la alimentación de agregados hasta la inyección de asfalto. Fabricado con componentes de grado industrial, asegura un rendimiento confiable en entornos exigentes. Su interfaz fácil de usar permite un control preciso de la temperatura, el flujo de material y el tiempo de mezclado, optimizando la producción y reduciendo errores del operador.`,
  },
  {
    src: "/Gallery/fueltank.webp",
    title: "Tanque de combustible",
    texto: `<span style="color:black">El tanque de combustible</span>, ubicado detrás del tanque de asfalto, tiene una capacidad de 750 litros y suministra diésel al sistema del quemador. Su ubicación permite un acceso fácil para recarga, manteniendo al mismo tiempo un diseño compacto dentro de la planta. Construido para ofrecer durabilidad y operación continua, permite jornadas prolongadas de producción sin interrupciones.`,
  },

  {
    src: "/Gallery/burner.webp",
    title: "Quemador",
    texto: `<span style="color:black">El quemador </span>optimiza la generación de calor para el proceso de secado y mezclado en la planta de asfalto, asegurando una combustión eficiente y estable. Fabricado con materiales de alta resistencia y componentes de grado industrial, mantiene un rendimiento confiable incluso en condiciones exigentes. Su sistema de control preciso ajusta automáticamente la relación aire-combustible para maximizar la eficiencia térmica, reducir el consumo de combustible y minimizar emisiones.`,
  },

  // agrega hasta 16 o más imágenes
];
---

<div
  id="Tanques"
  class="w-full flex flex-col items-center justify-start text-black bg-[url(/HeroIntegral.webp)] bg-no-repeat bg-center bg-cover min-h-[550px] md:min-h-[700px]"
>
  <div class="w-full max-w-7xl mx-auto px-8 my-4 md:my-14">
    <h1 class="text-2xl md:text-3xl text-start mb-1 md:mb-5 w-full font-bold">
      Plantas de asfalto de <br />
      contraflujo integrales de 10 Tph
    </h1>
    <h2
      class="text-lg md:text-xl text-start w-full font-semibold text-[#393939]"
    >
      Ideal para trabajos municipales y mantenimiento de carreteras
    </h2>
    <p class="mt-1 md:mt-5 text-[#313131] text-base md:text-lg font-semibold">
      Tecnología de gran escala en un formato compacto
    </p>
  </div>
</div>

<div class="pt-10">
  <h2 class="text-center font-bold text-black text-xl md:text-4xl">
    Todo en una sola unidad.
  </h2>
</div>
<div class="w-full lg:max-w-[2000px] mx-auto">
  <SlidersCarrusel client:load images={images2} />
</div>

<div class="flex flex-col justify-center items-center w-full">
  <h2 class="text-center font-bold text-[#14427c] text-xl md:text-3xl">
    Venda a un precio más bajo, atraiga a más clientes y obténga mayores
    ganancias.
  </h2><br />
  <a
    href="/IntegralAphaltPlant"
    aria-label="Go to page Integral Asphalt Plants"
    class="text-white text-center mb-5 mt-5 text-xs md:text-sm font-normal border-2 border-[#14427c] rounded-full py-2 px-6 transition-all duration-300 ease-out transform hover:scale-110 hover:shadow-lg bg-[#14427c] hover:bg-transparent hover:text-[#14427c]"
  >
    Conozca más de neustras plantas de asfalto de 10 Tph
  </a>
</div>

<div
  class="flex flex-col max-w-7xl mx-auto px-8 justify-center items-center bg-white rounded-2xl"
>
  <div class="pt-10">
    <h1 class="text-3xl text-black font-bold">Tanques de asfalto</h1>
  </div>

  <div class="flex flex-row justify-evenly w-full">
    <div
      class="flex flex-col items-center lg:items-start justify-center gap-10 md:gap-20 pb-5"
    >
      <div class="flex flex-col items-center justify-center">
        <div
          class="flex text-5xl font-normal justify-center lg:justify-start items-baseline w-full"
        >
          35
          <h1>-</h1>
          120
          <p class="text-sm font-normal ml-3">mil litros</p>
        </div>
        <p
          class="text-black font-thin text-center md:text-start lg:text-start w-full"
        >
          Capacidad de almacenamiento
        </p>
      </div>

      <div class="flex flex-col items-center justify-center">
        <div
          class="flex text-5xl font-normal justify-center lg:justify-start items-baseline w-full"
        >
          220
          <p class="text-sm font-normal ml-3">°C</p>
        </div>
        <p class="text-black font-thin text-center lg:text-start w-full">
          Máxima temperatura
        </p>
      </div>

      <div class="flex flex-col items-center justify-center">
        <div
          class="flex text-5xl font-normal justify-center lg:justify-start items-baseline w-full gap-2"
        >
          1
          <p>&</p>
          2.4
          <p class="text-sm font-normal">millones</p>
        </div>
        <p class="text-black font-thin text-center lg:text-start w-full">
          de capacidad Btu/hr
        </p>
      </div>
    </div>

    <div class="flex flex-col items-center justify-center">
      <div>
        <Image src={ASOdom} alt="Asphalt Storage Tank" />
      </div>
    </div>
  </div>
</div>

<div
  class="relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen md:static md:w-full md:ml-0 md:mr-0 bg-[url(/BgAST.webp)] bg-cover bg-no-repeat bg-center p-10 mt-10"
>
  <div class="max-w-7xl mx-auto px-8">
    <h2 class="font-bold text-white text-xl md:text-2xl">
      Tanques de almacenamiento de asfalto totalmente personalizables
    </h2><br />
    <div class="w-full flex flex-col lg:flex-row md:flex-col justify-between">
      <div class="w-full text-sm md:text-base">
        <h3 class="font-bold text-white">Sistemas de calentamiento</h3>
        <ul class="list-disc ml-6 font-thin text-white">
          <li>Fuego directo</li>
          <li class="list-none">
            <ul class="list-disc ml-10">
              <li>Calentamiento con gas LP (propano)</li>
              <li>Calentamiento con diésel</li>
            </ul>
          </li>
          <li>Calderas</li>
        </ul>
      </div>
      <div class="w-full text-sm md:text-base">
        <h3 class="font-bold text-white">Exterior</h3>
        <ul class="list-disc ml-6 font-thin text-white">
          <li>Barandales conforme a normas OSHA</li>
          <li>Flancos estéticos</li>
          <li>Sobre patas o sobre llantas</li>
        </ul>
      </div>
      <div class="w-full text-sm md:text-base">
        <h3 class="font-bold text-white">Incorporadores y agitadores</h3>
        <ul class="list-disc ml-6 font-thin text-white">
          <li>Incorporadores de hule</li>
          <li>Incorporadores para todo tipo de polímeros</li>
          <li>Agitadores para cualquier aplicación</li>
        </ul>
      </div>
      <div class="w-full text-sm md:text-base">
        <h3 class="font-bold text-white">Sistema general</h3>
        <ul class="list-disc ml-6 font-thin text-white">
          <li>Condensadores de vapor</li>
          <li>Válvulas manuales</li>
          <li>Con bomba sumergible</li>
          <li>Sistema de control computarizado</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<!-- Banner section -->
<div
  class="flex flex-col lg:flex-row bg-gradient-to-b from-blueMain from-50% to-blueSecondary to-50% lg:bg-gradient-to-r lg:from-blueMain lg:from-50% lg:to-blueSecondary lg:to-50%"
>
  <div class="flex flex-col max-w-7xl mx-auto py-14 lg:flex-row">
    <div
      class="w-full flex flex-col justify-center items-center gap-4 lg:mr-56"
    >
      <!-- Botón 1 -->
      <Whatsbtn />

      <a
        href="/Contact"
        aria-label="Button to request a quote"
        class="bg-blueSecondary border-white border border- text-white text-sm md:text-lg rounded-full w-full py-2 flex items-center justify-center gap-2 shadow-md hover:bg-[#0044A4]/80"
      >
        Solicitar una cotización
        <svg
          width="24px"
          height="24px"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          color="#FFFFFF"
        >
          <!-- Icono del segundo botón (opcional) -->
          <path
            d="M5 12H19M19 12L12 5M19 12L12 19"
            stroke="#FFFFFF"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
    <div
      class="w-full h-full flex flex-col text-white justify-center items-center lg:items-end lg:justify-evenly"
    >
      <h1 class="font-bold w-full text-sm lg:text-xl lg:text-end">
        Alta productividad y calidad a precios competitivos
      </h1>
      <p
        class="text-sm lg:text-base text-center font-bold text-grisSubP lg:text-end"
      >
        Los contratistas que nos conocen prefieren Triaso sobre otras marcas por
        nuestra alta calidad, confiabilidad y precios.
      </p>
    </div>
  </div>
</div>
