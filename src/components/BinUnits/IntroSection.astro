---
import { Image } from "astro:assets";
import BOdometer from "./BOdometer";
import HeroImage from "../../assets/images/BinUnits/Tolv.webp";
import Slider from "../AsphaltStorage/Slider";
import img1 from "../../assets/images/AsphaltPlant/drum3.webp";
import img2 from "../../assets/images/BinUnits/ProvBU2.webp";
import img3 from "../../assets/images/BinUnits/ProvBU4.webp";
import img4 from "../../assets/images/SidePanels/TolvasFE.webp";
import img5 from "../../assets/images/BinUnits/BUFeeders.webp";
import HeroComponentV2 from "../unitComponents/HeroComponentV2.astro";

const slides = [
  {
    id: 1,
    title: "Vibrador en tolva de finos para flujo continuo de material",
    text: "Equipada con un vibrador en la tolva de finos para evitar la acumulación de material causada por la humedad y asegurar un flujo continuo de alimentación.",
    image: img1.src,
  },
  {
    id: 2,
    title: "Sistemas de dosificación de precisión en unidades de tolvas",
    text: "Desde nuestros inicios como fabricantes de plantas de asfalto, identificamos un problema en la mayoría de las plantas del mercado: la dosificación de agregados basada únicamente en peso y no en volumen. Este enfoque limita la precisión del diseño de mezcla, ya que el peso de los agregados varía con la humedad, mientras que el volumen se mantiene constante.",
    image: img2.src,
  },
  {
    id: 3,
    title: "Sistemas de dosificación por volumen preciso",
    text: "Nuestras tolvas están equipadas con sistemas de dosificación avanzados, diseñados para ofrecer la máxima precisión y confiabilidad. Garantizamos un flujo y una distribución exacta del material, cumpliendo con las necesidad de proyectos con especificaciones de exactitud.",
    image: img3.src,
  },
  {
    id: 4,
    title: "Flancos estéticos",
    text: "Estos paneles que destacan originalidad brindan un aspecto limpio, moderno y estético que refleja calidad y atención al detalle, dejando una fuerte impresión en clientes, inspectores y en el público. Ideales para proyectos en zonas urbanas o de alta visibilidad, refuerzan el compromiso de su marca con la excelencia y mejoran la presentación general de su planta de asfalto.",
    image: img4.src,
  },
  {
    id: 5,
    title: "Alimentadores de banda ",
    text: "Nuestros alimentadores de banda están equipados con poleas de cabeza y cola recubiertas de hule, lo que proporciona una tracción firme y minimiza el deslizamiento durante la operación. Este diseño aumenta la resistencia al desgaste, reduce el deterioro de la banda y garantiza un desempeño confiable incluso bajo cargas pesadas y en condiciones de trabajo exigentes.",
    image: img5.src,
  },
];
---

<HeroComponentV2
  title="Unidades de tolvas independientes para agregados Triaso®"
  titleColor="white"
  textColor="white"
  bgColor="#1e1e1e"
  text="La unidad de tolvas Triaso® es un equipo esencial en la producción de mezcla asfáltica, garantizamos un almacenamiento preciso y un flujo constante de agregados hacia el sistema de mezclado. Diseñadas específicamente para plantas de asfalto, permiten una dosificación confiable de los agregados virgenes, ayudando a mantener la consistencia de la mezcla y la eficiencia de producción según la diseño de la mezcla establecida."
  heroImage={HeroImage.src}
/>

<section>
  <BOdometer client:only />
</section>

<section>
  <div
    class="w-full bg-blueMain text-white flex flex-col justify-center pt-10 h-full"
  >
    <div
      class="p-4 md:p-10 font-bold flex flex-col lg:flex-row md:flex-row items-center justify-center gap-4 max-w-7xl mx-auto"
    >
      <div>
        <Image src={img1} alt="Lines resembling the shape of a Bin Unit" />
      </div>
      <div class="px-8 w-full lg:w-1/2">
        <h1 class="text-white text-sm md:text-base font-normal">
          Fabricadas con materiales de extra-reforzados y disponibles en
          configuraciones adaptables, estas tolvas ofrecen larga vida útil,
          mínimo mantenimiento y un desempeño óptimo para operación continua en
          cualquier tipo de proyecto.
        </h1>
      </div>
    </div>
    <div class="w-full bg-bgBeige -skew-y-2">
      <div
        class="w-full grid grid-cols-1 md:grid-cols-2 py-20 max-w-7xl mx-auto px-8 skew-y-2 gap-3 md:gap-10"
      >
        <div class="w-full text-center text-black">
          <h1 class="font-bold text-black text-lg md:text-2xl">
            Fabricación resistente
          </h1><br />
          <p class="text-sm md:text-lg">
            Nuestras unidades de tolvas están fabricadas con materiales
            resistentes al desgaste y extra-reforzados, ideales para manejar
            cargas abrasivas y de alto peso. Esta construcción robusta asegura
            un funcionamiento confiable incluso en las condiciones de trabajo
            más exigentes.
          </p>
        </div>
        <div class="w-full text-center text-black">
          <h1 class="font-bold text-black text-lg md:text-2xl">
            Características personalizables
          </h1><br />
          <p class="text-sm md:text-lg">
            El sistema de dosificación ofrece una flexibilidad excepcional para
            adaptarse a las necesidades específicas de cada proyecto. Con
            opciones de ajuste manual o automático, el sistema garantiza un
            control preciso del flujo de material.
          </p>
        </div>
      </div>
    </div>

    <div class="w-full relative flex flex-col pt-5">
      <div class="max-w-7xl mx-auto px-8">
        <Image src={HeroImage} alt="Semi silo" width={600} height={400} />
      </div>

      <div class="">
        <Slider slides={slides} client:only />
      </div>
    </div>
  </div>
</section>
