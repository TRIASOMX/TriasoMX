---
import Image from "astro/components/Image.astro";
import item1 from "../../assets/images/DrumMixers/a3.webp";
import item2 from "../../assets/images/DrumMixers/a5.webp";
import item3 from "../../assets/images/DrumMixers/a4.webp";
import item4 from "../../assets/images/DrumMixers/Low/a2Low.webp";
import item5 from "../../assets/images/DrumMixers/a6.jpg";
import item6 from "../../assets/images/DrumMixers/a1.webp";
---

<div
  class="bg-white py-8 px-2 md:px-20 rounded-2xl flex flex-col items-center justify-center my-11"
>
  <details class="group w-full flex flex-col justify-between">
    <summary
      class="flex flex-col justify-between items-center cursor-pointer list-none"
    >
      <div class="w-full flex justify-between mb-6">
        <div class="flex flex-col gap-3">
          <h1 class="text-2xl lg:text-5xl md:text-5xl font-normal">
            Álabes Triaso de
          </h1>
          <h1 class="text-2xl lg:text-5xl md:text-5xl font-normal">
            tambor mezclador
          </h1>
        </div>
        <div>
          <svg
            class="transition-transform duration-300 group-open:rotate-180"
            width="64px"
            height="64px"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            color="#0044a4"
            stroke-width="1.5"
            ><path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 1.25C6.06294 1.25 1.25 6.06294 1.25 12C1.25 17.9371 6.06294 22.75 12 22.75C17.9371 22.75 22.75 17.9371 22.75 12C22.75 6.06294 17.9371 1.25 12 1.25ZM16.0303 13.0303L12.5303 16.5303C12.2374 16.8232 11.7626 16.8232 11.4697 16.5303L7.96967 13.0303C7.67678 12.7374 7.67678 12.2626 7.96967 11.9697C8.26256 11.6768 8.73744 11.6768 9.03033 11.9697L11.25 14.1893V8C11.25 7.58579 11.5858 7.25 12 7.25C12.4142 7.25 12.75 7.58579 12.75 8V14.1893L14.9697 11.9697C15.2626 11.6768 15.7374 11.6768 16.0303 11.9697C16.3232 12.2626 16.3232 12.7374 16.0303 13.0303Z"
              fill="#0044a4"></path></svg
          >
        </div>
      </div>
    </summary>
    <p
      class="font-light text-sm lg:text-base md:text-base px-2 lg:px-0 md:px-0"
    >
      El sistema de álabes optimiza el proceso y reduce el consumo de
      combustible y la temperatura de salida. Menos costos operativos y un menor
      impacto ambiental, todo ello sin dejar de mantener el máximo rendimiento
      con un consumo de combustible mínimo.
    </p>
  </details>

  <div
    class="grid grid-cols-3 md:grid-cols-6 items-start justify-around gap-5 my-10 w-full"
  >
    <div class="flex flex-col items-center justify-center font-light">
      <div class="h-[140px] flex items-center justify-center">
        <Image
          src={item1}
          width={200}
          height={200}
          alt="Inlet Flight"
          class="h-full w-auto object-contain"
        />
      </div>
      <div class="text-center">
        <p>Álabe de entrada</p>
      </div>
    </div>
    <div class="flex flex-col items-center justify-center font-light">
      <div class="h-[140px] flex items-center justify-center">
        <Image
          src={item2}
          width={200}
          height={200}
          alt="Pusher Flight"
          class="h-full w-auto object-contain"
        />
      </div>
      <div class="text-center">
        <p>Álabe de acondicionamiento</p>
      </div>
    </div>
    <div class="flex flex-col items-center justify-center font-light">
      <div class="h-[140px] flex items-center justify-center">
        <Image
          src={item3}
          width={200}
          height={200}
          alt="Drying Flight"
          class="h-full w-auto object-contain"
        />
      </div>
      <div class="text-center">
        <p>Álabe de secado</p>
      </div>
    </div>
    <div class="flex flex-col items-center justify-center font-light">
      <div class="h-[140px] flex items-center justify-center">
        <Image
          src={item4}
          width={200}
          height={200}
          alt="RAP Flight"
          class="h-full w-auto object-contain"
        />
      </div>
      <div class="text-center">
        <p>Álabe RAP</p>
      </div>
    </div>
    <div class="flex flex-col items-center justify-center font-light">
      <div class="h-[140px] flex items-center justify-center">
        <Image
          src={item5}
          width={200}
          height={200}
          alt="Radiation Flight"
          class="h-full w-auto object-contain"
        />
      </div>
      <div class="text-center">
        <p>Álabe de radiación</p>
      </div>
    </div>
    <div class="flex flex-col items-center justify-center font-light">
      <div class="h-[140px] flex items-center justify-center">
        <Image
          src={item6}
          width={200}
          height={200}
          alt="Mixing Flight"
          class="h-full w-auto object-contain"
        />
      </div>
      <div class="text-center">
        <p>Álabe de mezclado</p>
      </div>
    </div>
  </div>
</div>
