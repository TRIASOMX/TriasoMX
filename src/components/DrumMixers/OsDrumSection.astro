---
import { Image } from "astro:assets";
import OSHand from "../../assets/images/OSHand.webp";
import Slider from "../LandinPage/SliderOs";
---

<section class="bg-[#1e1e1e] mt-20 overflow-visible pb-10">
  <div class="max-w-7xl mx-auto lg:px-0">
    <div class="grid grid-cols-1 md:grid-cols-3 items-center gap-12">
      <!-- Texto -->
      <div class="text-white w-full px-8 col-span-1 md:col-span-2">
        <h1
          class="text-2xl md:text-4xl font-semibold my-6 bg-gradient-to-r from-[#f8ad00] via-[#dc363a] to-[#3992ff] bg-clip-text text-transparent"
        >
          Sistema de operación Triaso® − Relief
        </h1>
        <p
          class="text-[#adadad] font-semibold leading-relaxed text-sm md:text-base"
        >
          Ofrecemos una forma práctica y eficiente de gestionar el
          funcionamiento de nuestros equipos. Con monitoreo y automatización
          avanzados, <span class="text-white"
            >simplificamos la operación de su planta de asfalto y del personal.
          </span> Control total de todos los procesos de la producción y rastreo de
          cada dato de la operación.
        </p>
      </div>

      <!-- Imagen -->
      <div class="flex justify-end relative col-span-1 md:col-span-1">
        <Image
          src={OSHand}
          alt="Triaso OS"
          class="w-[280px] md:w-[360px] lg:w-[420px] lg:-translate-y-16"
        />
      </div>
    </div>

    <Slider client:only />
  </div>
</section>

<script is:inline>
  let currentSlide = 0;
  const slider = document.getElementById("slider");

  function getVisibleSlides() {
    if (window.innerWidth >= 1024) return 4;
    if (window.innerWidth >= 640) return 2;
    return 1;
  }

  function nextSlide() {
    const visible = getVisibleSlides();
    const total = slider.children.length;
    currentSlide = (currentSlide + 1) % (total - visible + 1);
    slider.style.transform = `translateX(-${currentSlide * (100 / visible)}%)`;
  }

  function prevSlide() {
    const visible = getVisibleSlides();
    const total = slider.children.length;
    currentSlide =
      (currentSlide - 1 + (total - visible + 1)) % (total - visible + 1);
    slider.style.transform = `translateX(-${currentSlide * (100 / visible)}%)`;
  }
</script>
