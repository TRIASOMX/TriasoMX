---
import DropdownItem from "../unitComponents/DropdownItem.astro";
import SecondWhatsBtn from "../unitComponents/SecondWhatsBtn.astro";
import poster from "../../../public/Videos/Webm/Posters/landing1.webp";
import { Image } from "astro:assets";
import SmartVideo from "../unitComponents/SmartVideo";
import DMProv1 from "../../assets/images/DrumMixers/DMProv1.webp";
import obracivil from "../../assets/images/DrumMixers/obracivil.webp";
import obracivil2 from "../../assets/images/DrumMixers/obracivil2.webp";
import obracivil2Low from "../../assets/images/DrumMixers/Low/obracivil2Low.webp";
import CasetaSeccion from "../DrumMixers/CasetaSeccion.astro";
import AlabeSection from "./AlabeSection.astro";

const drumMixersPanels = [
  {
    title: "Producción y operación",
    items: [
      {
        label:
          "Ahorro en operadores innecesarios, gracias a una operación más automatizada y controlada.",
      },
      {
        label:
          "Ahorro en la eliminación de la fosa de lodos y su costosa operación.",
      },
      {
        label:
          "Ahorro en agregados vírgenes por el alto porcentaje de incorporación del RAP.",
      },
      {
        label:
          "Ahorro en jornadas laborales al evitar paros costosos y prolongados del equipo.",
      },
      {
        label:
          "Ahorro por menor desperdicio de mezcla fuera de especificación.",
      },
      {
        label: "Ahorro en costos de calibración y ajustes frecuentes.",
      },
      {
        label: "Ahorro en multas por la SEMARNAT por emisiones contaminantes.",
      },
      {
        label: "Ahorro en multas por operación ruidosa en zona urbanas.",
      },
    ],
  },
  {
    title: "Mantenimiento y vida útil del equipo",
    items: [
      {
        label:
          "Gracias a componentes extra-reforzados diseñados para una larga vida útil.",
      },
      { label: "Por ser equipos fabricados en México y no de importación." },
      { label: "Ahorro en refacciones recurrentes." },
      { label: "Ahorro por mayor vida útil de filtros y mangas." },
      { label: "Ahorro por menor desgaste en el tambor y los álabes." },
    ],
  },
  {
    title: "Energéticos y de consumo",
    items: [
      {
        label: "Ahorro de combustible por la eficiencia de:",
        subItems: [
          { subLabel: "Nuestro quemador con sistema de precalentamiento" },
          { subLabel: "Nuestro sistema de combustión asistido por plasma" },
          { subLabel: "El diseño de nuestros álabes" },
          {
            subLabel:
              "Un tambor completamente sellado, sin entradas de aire frío",
          },
          {
            subLabel:
              "La capacidad de producir mezclas tibias cuando el diseño lo requiera",
          },
        ],
      },
      { label: "Ahorro en consumo eléctrico" },
      {
        label:
          "La eficiencia del sistema de secado, ventilación y filtración reduce la carga eléctrica total por tonelada producida, especialmente en ventiladores y sistemas auxiliares",
      },
      {
        label:
          "Ahorro por menor sobrecalentamiento del agregado, al no requerir temperaturas excesivas para compensar pérdidas térmicas, reduciendo consumo energético y degradación del material.",
      },
    ],
  },
];

---

<!-- Sección hotspot -->
<section class="py-20">
  <div>
    <div
      class="max-w-7xl mx-auto px-8 space-y-5 flex flex-col items-center justify-center"
    >
      <h1 class="font-bold text-black text-4xl">
        Inconfundible. Desde todas las perspectivas.
      </h1>
      <img src="https://placehold.co/1920x1080/png" alt="Placeholder" />
    </div>
  </div>
</section>

<!-- Sección dropdowns -->
<section class="max-w-7xl mx-auto px-8">
  <div class="flex justify-center items-center">
    <h1 class="text-black font-bold text-4xl">
      Ahorros que usted podrá lograr con la planta de adfalto
    </h1>
  </div>

  <div>
    <DropdownItem panels={drumMixersPanels} />
  </div>
</section>

<!-- Sección banner -->

<section class="">
  <div
    class="bg-black lg:h-[50vh] md:h-[50vh] flex items-center bg-[url(/drumBanner.webp)] bg-cover bg-center bg-no-repeat relative"
  >
    <div class="absolute inset-0 bg-[#000000]/70"></div>
    <div class="max-w-7xl mx-auto px-8 space-y-5 relative">
      <div class="pt-5">
        <h1 class="text-4xl font-bold text-white">
          ¿Indeciso sobre el equipo ideal para su proyecto?
        </h1>
      </div>

      <div
        class="w-full flex flex-col justify-center pb-5 lg:justify-around md:justify-around items-center lg:flex-row relative"
      >
        <div class="">
          <p class="text-white">
            La compra de una planta de asfalto es una gran inversión, y la base
            de un negocio de producción de mezcla asfáltica. Compre
            inteligentemente y con criterio.
          </p>
          <p class="text-white">
            Podemos asesorarlo de forma transparente en la inversión de su
            planta de asfalto, ayudándolo a elegir la opción más adecuada.
          </p>
        </div>
        <div
          class="w-full flex flex-col justify-center items-center gap-4 mb-5 lg:ml-28"
        >
          <!-- Botón 1 -->
          <SecondWhatsBtn />

          <a
            href="/Contact"
            aria-label="Button to request a quote"
            class="border-white border text-white text-sm md:text-lg rounded-full w-full py-2 flex items-center justify-between gap-2 shadow-md"
          >
            <div class="px-5 py-2">
              <p>Solicitar una cotización</p>
            </div>
            <div class="px-5 py-2">
              <svg
                width="24px"
                height="24px"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                color="#FFFFFF"
              >
                <!-- Icono del segundo botón (opcional) -->
                <path
                  d="M5 12H19M19 12L12 5M19 12L12 19"
                  stroke="#FFFFFF"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Otra sección  -->
<section class="max-w-7xl mx-auto px-8">
  <AlabeSection />

  <SmartVideo
    client:visible
    src="/Videos/Webm/landingVideo.webm"
    aspectRatio="16/9"
    poster={poster.src}
    autoplayOnMobile={false}
    isLoop={false}
  />
</section>

<!-- Animación -->

<section>
  <div class="w-full flex flex-col font-bold mt-5 lg:mt-0">
    <div class="max-w-7xl px-8 mb-10 lg:mb-28 mx-auto lg:pt-0">
      <h1 class="text-redBg text-xl lg:text-5xl md:text-5xl text-center">
        La única e inigualable.
      </h1>
    </div>

    <div class="hidden max-w-7xl px-8 mx-auto lg:flex justify-start">
      <Image
        src={obracivil}
        alt="Drum mixer on a construction zone"
        class="hero-img lg:w-[80%] rounded-lg"
      />
    </div>
    <div class="flex max-w-7xl px-8 mx-auto lg:hidden md:flex justify-center">
      <Image
        src={obracivil}
        alt="Drum mixer on a construction zone"
        class="lg:w-4/5 rounded-lg"
      />
    </div>

    <div class="bg-[#1e1e1e]">
      <div
        class="max-w-7xl px-8 mx-auto flex flex-col lg:flex-row justify-between items-center py-2"
      >
        <div class="flex flex-col md:flex-row gap-6 lg:w-[40%]">
          <div class="w-full">
            <h2 class="text-white text-lg md:text-xl">
              Diseñada para producciones exigentes y de gran volumen fabricación
              para un rendimiento sin comparación
            </h2>
            <p
              class="text-[#f3f3f5] text-sm lg:text-base md:text-base text-justify"
            >
              Fabricados con materiales de alta resistencia y componentes de
              larga vida útil, estos tambores garantizan eficiencia energética
              superior y una mezcla asfáltica de calidad consistente. Ideales
              para operaciones exigentes, donde la confiabilidad de la planta es
              clave, sabiendo que el desempeño de toda la operación depende
              directamente de la confiabilidad del equipo.
            </p>
          </div>
        </div>
        <div class="w-full hidden lg:flex md:w-auto">
          <Image
            src={obracivil2}
            width={600}
            height={400}
            alt="Baghouse cleaning system"
            class="side-img rounded-2xl will-change-transform"
          />
        </div>
      </div>
    </div>
    <div
      class="max-w-7xl hidden px-8 mx-auto lg:flex justify-center lg:justify-start"
    >
      <Image
        src={DMProv1}
        alt="Usage of a Drum mixer"
        class="fade-img rounded-lg lg:w-3/5"
      />
    </div>

    <div
      class="relative grid grid-cols-2 max-w-7xl mx-auto px-8 items-center mt-5 lg:hidden"
    >
      <Image src={obracivil2Low} alt="Drum mixer" class="rounded-2xl w-4/5" />
      <Image src={DMProv1} alt="Usage of a Drum mixer" class="rounded-lg" />
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-8 mt-20">
    <div class="flex flex-col">
      <h1 class="text-4xl">
        Con <span class="italic font-bold">Triaso</span>
      </h1>
      <p class="font-bold text-[#14427c] text-3xl">
        conviértase en el proveedor preferido de mezcla asfáltica
      </p>
      <p class="font-bold text-[#14427c] text-3xl">
        en todos los proyectos de pavimentación de su región.
      </p>
    </div>
  </div>
</section>

<section>
  <CasetaSeccion />
</section>

<script>
  import { initScrollAnimations } from "../../components/DrumMixers/Contraflujo/Desamaq/scrollDesamaq";

  if (typeof window !== "undefined") {
    window.addEventListener("DOMContentLoaded", () => {
      initScrollAnimations();
    });
  }
</script>
