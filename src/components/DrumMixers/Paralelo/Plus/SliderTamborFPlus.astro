<style>
  @media (max-width: 639px) {
    .card-row {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 0.5rem;
      scrollbar-width: none;
    }
    .card-row::-webkit-scrollbar {
      display: none;
    }

    .card-row > * {
      flex: 0 0 85%;
      scroll-snap-align: start;
    }
  }
</style>

<script>
  const AUTO_INTERVAL = 10000;

  const cardTrack = document.getElementById("cardTrack") as HTMLElement;
  const cards = Array.from(
    cardTrack.querySelectorAll<HTMLElement>("[data-card]"),
  );
  const cardDotsContainer = document.getElementById("cardDots");

  const infoViewport = document.getElementById("infoViewport");
  const infoTrack = document.getElementById("infoTrack") as HTMLElement | null;

  const dots = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-dot]"),
  );

  const groupStartIndex: number[] = [];
  cards.forEach((card, i) => {
    const group = Number(card.dataset.card!.split("-")[0]);
    if (groupStartIndex[group] === undefined) groupStartIndex[group] = i;
  });

  const TOTAL_SLIDES = infoTrack ? infoTrack.children.length : dots.length;

  function cardGroup(cardIndex: number): number {
    return Number(cards[cardIndex].dataset.card!.split("-")[0]);
  }

  function isMobile() {
    return window.innerWidth < 640;
  }

  let current = 0;
  let timer: ReturnType<typeof setInterval>;
  let isProgrammaticScroll = false;

  function setActiveDots(index: number) {
    dots.forEach((dot, i) => {
      const active = i === index;
      dot.setAttribute("aria-selected", String(active));
      dot.className = active
        ? "dot w-3 h-3 rounded-full bg-gray-800 transition-all duration-300"
        : "dot w-2 h-2 mt-0.5 rounded-full bg-gray-300 transition-all duration-300 hover:bg-gray-500";
    });
  }

  function updateCardDots(activeIndex: number) {
    if (!cardDotsContainer) return;
    const dotEls = Array.from(
      cardDotsContainer.querySelectorAll<HTMLElement>(".card-dot"),
    );
    dotEls.forEach((dot, i) => {
      dot.className =
        i === activeIndex
          ? "card-dot w-2 h-2 rounded-full bg-gray-800 transition-all duration-300"
          : "card-dot w-1.5 h-1.5 mt-0.5 rounded-full bg-gray-300 transition-all duration-300";
    });
  }

  function buildCardDots() {
    if (!cardDotsContainer) return;
    cardDotsContainer.innerHTML = cards
      .map((_, i) =>
        i === 0
          ? '<span class="card-dot w-2 h-2 rounded-full bg-gray-800"></span>'
          : '<span class="card-dot w-1.5 h-1.5 mt-0.5 rounded-full bg-gray-300"></span>',
      )
      .join("");
  }

  function positionCardTrack(index: number) {
    const startIndex = groupStartIndex[index] ?? 0;
    const targetCard = cards[startIndex];
    if (!targetCard) return;

    if (isMobile()) {
      isProgrammaticScroll = true;
      cardTrack.scrollTo({ left: targetCard.offsetLeft, behavior: "smooth" });
      window.setTimeout(() => {
        isProgrammaticScroll = false;
      }, 600);
    } else {
      cardTrack.style.transform = `translateX(-${targetCard.offsetLeft}px)`;
    }
    updateCardDots(startIndex);
  }

  function goTo(index: number, moveCards = true) {
    current = (index + TOTAL_SLIDES) % TOTAL_SLIDES;

    if (infoTrack) {
      infoTrack.style.transform = `translateX(-${current * 100}%)`;
    }
    setActiveDots(current);
    if (moveCards) positionCardTrack(current);
  }

  function startAuto() {
    timer = setInterval(() => goTo(current + 1), AUTO_INTERVAL);
  }
  function resetAuto() {
    clearInterval(timer);
    startAuto();
  }

  dots.forEach((dot) => {
    dot.addEventListener("click", () => {
      goTo(Number(dot.dataset.dot));
      resetAuto();
    });
  });

  cardTrack.addEventListener(
    "scroll",
    () => {
      if (!isMobile() || isProgrammaticScroll) return;

      let nearest = 0;
      let nearestDist = Infinity;
      cards.forEach((card, i) => {
        const dist = Math.abs(card.offsetLeft - cardTrack.scrollLeft);
        if (dist < nearestDist) {
          nearestDist = dist;
          nearest = i;
        }
      });

      updateCardDots(nearest);

      const group = cardGroup(nearest);
      if (group !== current) {
        goTo(group, false);
        resetAuto();
      }
    },
    { passive: true },
  );

  document
    .querySelectorAll<HTMLButtonElement>(".mostrar-mas")
    .forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const expandible = btn.nextElementSibling as HTMLElement;
        const chevron = btn.querySelector(".chevron") as HTMLElement;
        const overlay = btn.parentElement as HTMLElement;
        const darken = overlay.previousElementSibling as HTMLElement;
        const isOpen =
          expandible.style.maxHeight && expandible.style.maxHeight !== "0px";

        if (isOpen) {
          expandible.style.maxHeight = "0px";
          chevron.style.transform = "rotate(0deg)";
          btn.setAttribute("aria-expanded", "false");
          darken.classList.remove("opacity-100");
          darken.classList.add("opacity-0");
        } else {
          expandible.style.maxHeight = expandible.scrollHeight + "px";
          chevron.style.transform = "rotate(180deg)";
          btn.setAttribute("aria-expanded", "true");
          darken.classList.remove("opacity-0");
          darken.classList.add("opacity-100");
        }
      });
    });

  if (infoViewport) {
    let touchStartX = 0;
    let touchStartY = 0;

    infoViewport.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      },
      { passive: true },
    );

    infoViewport.addEventListener("touchend", (e) => {
      const deltaX = touchStartX - e.changedTouches[0].clientX;
      const deltaY = Math.abs(touchStartY - e.changedTouches[0].clientY);
      if (Math.abs(deltaX) > 50 && Math.abs(deltaX) > deltaY) {
        goTo(deltaX > 0 ? current + 1 : current - 1);
        resetAuto();
      }
    });
  }

  buildCardDots();
  goTo(0, false);
  updateCardDots(0);
  startAuto();
</script>
