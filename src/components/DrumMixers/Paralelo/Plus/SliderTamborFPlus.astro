<section
  id="tamborMezclador"
  class="w-full select-none min-h-[90vh]"
  aria-label="Tambor Mezclador"
>
  <h2
    class="font-bold text-2xl lg:text-3xl text-black mb-5 uppercase my-2 md:my-10"
  >
    Tambor Mezclador
  </h2>

  <div class="card-row-wrapper relative overflow-hidden">
    <div class="card-row flex gap-3" id="cardTrack">
      <!-- Card 0-0 -->
      <div
        class="relative rounded-lg overflow-hidden group cursor-pointer shrink-0 sm:basis-[calc((100%-1.5rem)/3)]"
        data-card="0-0"
      >
        <div class="w-full h-56 sm:h-80 lg:h-96 bg-black/10 overflow-hidden">
          <img
            src={slider1.src}
            alt="Roles de carga"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>

        <div
          class="card-darken absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/95 to-transparent opacity-0 transition-opacity duration-700 ease-in-out pointer-events-none"
        >
        </div>

        <div
          class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-3 sm:p-4"
        >
          <span
            class="font-bold text-white text-sm sm:text-base uppercase tracking-wide leading-tight mb-2"
          >
            Roles de carga
          </span>

          <button
            class="mostrar-mas flex items-center gap-1 text-white/80 text-xs hover:text-white transition-colors"
            aria-expanded="false"
          >
            <svg
              class="chevron w-3 h-3 transition-transform duration-300"
              viewBox="0 0 12 12"
              fill="none"
            >
              <path
                d="M2 4l4 4 4-4"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path>
            </svg>
            mostrar más
          </button>

          <div
            class="expandible max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out"
          >
            <p class="text-white/75 text-xs sm:text-sm leading-relaxed mt-2">
              Roles de carga extra reforzados fabricados en acero forjado,
              maquinado con precisión y equipados con rodamientos
              industriales para una rotación del tambor suave y estable.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 0-1 -->
      <div
        class="relative rounded-lg overflow-hidden group cursor-pointer shrink-0 sm:basis-[calc((100%-1.5rem)/3)]"
        data-card="0-1"
      >
        <div class="w-full h-56 sm:h-80 lg:h-96 bg-black/10 overflow-hidden">
          <img
            src={slider2.src}
            alt="Variadores de velocidad de giro"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>

        <div
          class="card-darken absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/95 to-transparent opacity-0 transition-opacity duration-700 ease-in-out pointer-events-none"
        >
        </div>

        <div
          class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-3 sm:p-4"
        >
          <span
            class="font-bold text-white text-sm sm:text-base uppercase tracking-wide leading-tight mb-2"
          >
            Sistema de ajuste centralizado
          </span>

          <button
            class="mostrar-mas flex items-center gap-1 text-white/80 text-xs hover:text-white transition-colors"
            aria-expanded="false"
          >
            <svg
              class="chevron w-3 h-3 transition-transform duration-300"
              viewBox="0 0 12 12"
              fill="none"
