---
import SmartVideo from "../unitComponents/SmartVideo";
import poster1 from "../../assets/images/Burners/Gallery/B1.webp";
---

<section>
  <!-- Sección arriba -->
  <div
    class="max-w-7xl mx-auto px-8 flex flex-col lg:flex-row justify-center lg:justify-between"
  >
    <div class="">
      <div>
        <h1
          class="uppercase text-2xl md:text-5xl font-extrabold text-[#393939]"
        >
          Quemadores de
        </h1>
        <h1
          class="uppercase text-2xl md:text-5xl font-extrabold text-[#393939]"
        >
          aire total
        </h1>
        <div class="border-b-2 border-[#ca1c1c] h-0.5 w-full my-5"></div>
      </div>
      <div class="flex flex-col">
        <p>Desde 6 a 125 millones de Btu/Hr,</p>
        <p>con precalentador, filtro y más</p>
      </div>
    </div>
    <div class="flex items-center justify-center lg:justify-end w-full">
      <SmartVideo
        client:visible
        src="/Videos/Webm/burnerVideo.webm"
        width="70%"
        poster={poster1.src}
        isLoop={true}
        autoplayOnMobile={false}
      />
    </div>
  </div>
  <!-- Sección 2 -->
  <div class="flex flex-col md:flex-row gap-4 max-w-7xl mx-auto px-8">
    <div
      class="bg-white lg:w-[600px] rounded-2xl flex justify-center items-center"
    >
      <div class="mx-auto py-10">
        <p class="font-bold text-xl md:text-2xl">Aire 100% regulado</p>
      </div>
    </div>
    <div
      class="bg-[#393939] rounded-2xl lg:w-[600px] flex justify-center items-center"
    >
      <div class="mx-auto py-10">
        <p class="font-bold text-white text-xl md:text-2xl">
          Bajas emisiones de NOx
        </p>
      </div>
    </div>
  </div>
</section>
