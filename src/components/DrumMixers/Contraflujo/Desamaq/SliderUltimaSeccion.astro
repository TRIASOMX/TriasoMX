---
import tanqueAsfalto from "../../../../assets/images/AsphaltStorage/SliderStorage/P-3a.webp";
import silo from "../../../../assets/images/HotMix/siloBG.webp";
import rapBin from "../../../../assets/images/RapBins/Low/cdcd.png";
import powderAd from "../../../../assets/images/PowderA/Gallery/PAF1.webp";
const slides = [
  {
    id: 1,
    title: "Tanque de asfalto",
    description:
      "Diseñados para almacenar y mantener el asfalto en condiciones óptimas, asegurando una calidad, desempeño y control toal de su asfalto.",
    image: tanqueAsfalto.src,
    url: "/AsphaltStorage",
  },
  {
    id: 2,
    title: "Silos de mezcla asfáltica",
    description:
      "Diseñados para optimizar el almacenamiento, manejo y suministro de mezcla asfáltica.",
    image: silo.src,
    url: "/Hot-mix-storage-silos",
  },
  {
    id: 3,
    title: "Tolvas de RAP",
    description:
      "Diseñadas para almacenamiento preciso y la dosificación controlada de pavimento asfáltico recuperado (RAP) en la producción del tambor mezclador",
    image: rapBin.src,
    url: "/RAP-bins",
  },
  {
    id: 4,
    title: "Alimentador de aditivos en polvo con tolva",
    description:
      "Diseñados para el almacenamiento y manejo eficiente de materiales secos y pulverizados",
    image: powderAd.src,
    url: "/PowderAdditives",
  },
];

const duplicatedSlides = [...slides, ...slides];
---

<section class="py-10 lg:flex lg:flex-col lg:justify-center">
  <div class="max-w-7xl mx-auto px-0 md:px-4 w-full">
    <div class="relative">
      <div class="overflow-hidden" id="slider-wrapper">
        <div
          class="flex gap-6 transition-transform duration-500 ease-in-out"
          id="slider-track"
        >
          {
            duplicatedSlides.map((slide, index) => (
              <div
                class="
                  slide-item
                  flex-shrink-0
                  w-full
                  sm:w-[calc(50%-12px)]
                  lg:w-[calc(46%-14px)]
                  relative
                  rounded-xl
                  overflow-hidden
                  min-h-[280px]
                  md:min-h-[320px]
                  lg:min-h-[480px]
                "
                data-index={index}
              >
                <img
                  src={slide.image}
                  alt={slide.title}
                  class="absolute inset-0 w-full h-full object-cover"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-black/25" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/60 to-black/10" />
                <div class="absolute bottom-0 left-0 right-0 p-5 lg:p-8 text-white space-y-4 lg:space-y-5">
                  <h3 class="font-bold text-lg lg:text-2xl mb-2">
                    {slide.title}
                  </h3>
                  <p class="text-xs lg:text-base text-gray-200 leading-relaxed">
                    {slide.description}
                  </p>
                  <a
                    href={slide.url}
                    class="flex w-full items-center justify-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-semibold text-gray-900 shadow-md active:scale-[0.97] transition-all duration-200 sm:inline-flex sm:w-auto sm:bg-transparent sm:text-white sm:font-normal sm:border sm:border-white/60 sm:shadow-none lg:px-6 lg:py-2.5 lg:text-base hover:bg-white hover:text-gray-700"
                  >
                    Saber más
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="w-4 h-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <button
        id="prev-btn"
        class="absolute left-0 top-1/2 -translate-y-1/2 lg:-translate-x-12 md:-translate-x-4 z-10 bg-white/90 backdrop-blur-sm border border-white/40 rounded-full w-10 h-10 lg:w-14 lg:h-14 flex items-center justify-center shadow-lg hover:bg-redBg hover:border-redBg transition-all duration-300 group hidden md:flex"
        aria-label="Anterior"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5 lg:w-6 lg:h-6 text-blueMain group-hover:text-white transition-colors"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <button
        id="next-btn"
        class="absolute right-0 top-1/2 -translate-y-1/2 lg:translate-x-12 md:translate-x-4 z-10 bg-white/90 backdrop-blur-sm border border-white/40 rounded-full w-10 h-10 lg:w-14 lg:h-14 flex items-center justify-center shadow-lg hover:bg-redBg hover:border-redBg transition-all duration-300 group hidden md:flex"
        aria-label="Siguiente"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5 lg:w-6 lg:h-6 text-blueMain group-hover:text-white transition-colors"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>

    <div class="flex justify-center gap-2 mt-6" id="dots-container">
      {
        slides.map((_, i) => (
          <button
            class="dot w-3 h-3 lg:w-3.5 lg:h-3.5 rounded-full transition-all duration-300 hover:scale-110"
            data-dot={i}
            aria-label={`Ir al slide ${i + 1}`}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  (function () {
    const track = document.getElementById("slider-track") as HTMLElement;
    const wrapper = document.getElementById("slider-wrapper") as HTMLElement;
    const prevBtn = document.getElementById("prev-btn") as HTMLButtonElement;
    const nextBtn = document.getElementById("next-btn") as HTMLButtonElement;
    const dotsContainer = document.getElementById(
      "dots-container",
    ) as HTMLElement;
    const dots = dotsContainer.querySelectorAll<HTMLButtonElement>(".dot");

    const TOTAL_SLIDES = 4;
    let currentIndex = 0;
    let isTransitioning = false;
    let autoplayTimer: ReturnType<typeof setInterval>;

    function getSlidesVisible(): number {
      const w = window.innerWidth;
      if (w >= 1024) return 3;
      if (w >= 640) return 2;
      return 1;
    }

    function getSlideWidth(): number {
      const gap = 24;
      const slideItems = track.querySelectorAll<HTMLElement>(".slide-item");
      if (!slideItems.length) return 0;
      return slideItems[0].offsetWidth + gap;
    }

    function updateTrack(animate = true) {
      const offset = currentIndex * getSlideWidth();
      if (!animate) {
        track.style.transition = "none";
      } else {
        track.style.transition = "transform 500ms ease-in-out";
      }
      track.style.transform = `translateX(-${offset}px)`;
    }

    function updateDots() {
      const realIndex = currentIndex % TOTAL_SLIDES;
      dots.forEach((dot, i) => {
        if (i === realIndex) {
          dot.classList.add("bg-redBg");
          dot.classList.remove("bg-gray-300");
        } else {
          dot.classList.remove("bg-redBg");
          dot.classList.add("bg-gray-300");
        }
      });
    }

    function goToNext() {
      if (isTransitioning) return;
      isTransitioning = true;
      currentIndex++;
      updateTrack(true);

      if (currentIndex >= TOTAL_SLIDES) {
        setTimeout(() => {
          currentIndex = currentIndex % TOTAL_SLIDES;
          updateTrack(false);
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              isTransitioning = false;
            });
          });
        }, 1000);
      } else {
        setTimeout(() => {
          isTransitioning = false;
        }, 1000);
      }
      updateDots();
    }

    function goToPrev() {
      if (isTransitioning) return;
      isTransitioning = true;
      currentIndex--;
      if (currentIndex < 0) {
        currentIndex = TOTAL_SLIDES - 1;
        updateTrack(false);
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            track.style.transition = "transform 500ms ease-in-out";
            currentIndex--;
            if (currentIndex < 0) currentIndex = TOTAL_SLIDES - 1;
            updateTrack(true);
            setTimeout(() => {
              isTransitioning = false;
            }, 1000);
          });
        });
      } else {
        updateTrack(true);
        setTimeout(() => {
          isTransitioning = false;
        }, 1000);
      }
      updateDots();
    }

    function goToSlide(index: number) {
      if (isTransitioning) return;
      currentIndex = index;
      updateTrack(true);
      updateDots();
    }

    function startAutoplay() {
      autoplayTimer = setInterval(goToNext, 4000);
    }

    function stopAutoplay() {
      clearInterval(autoplayTimer);
    }

    function onResize() {
      getSlidesVisible();
      updateTrack(false);
    }

    nextBtn?.addEventListener("click", () => {
      stopAutoplay();
      goToNext();
      startAutoplay();
    });

    prevBtn?.addEventListener("click", () => {
      stopAutoplay();
      goToPrev();
      startAutoplay();
    });

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        stopAutoplay();
        goToSlide(i);
        startAutoplay();
      });
    });

    let touchStartX = 0;
    wrapper?.addEventListener("touchstart", (e) => {
      touchStartX = e.touches[0].clientX;
      stopAutoplay();
    });
    wrapper?.addEventListener("touchend", (e) => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        diff > 0 ? goToNext() : goToPrev();
      }
      startAutoplay();
    });

    window.addEventListener("resize", onResize);

    updateDots();
    startAutoplay();
  })();
</script>
