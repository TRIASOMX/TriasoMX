<section class="max-w-7xl mx-auto px-8">
  <SmartVideo
    client:visible
    src="/Videos/Webm/landingVideo.webm"
    aspectRatio="16/9"
    poster={poster.src}
    autoplayOnMobile={false}
    isLoop={false}
  />
  <AlabeSection />
</section>

<section class="min-h-[80vh] py-6 md:py-20">
  <CasetaSeccionMontable />
</section>

<script>
  import { initScrollAnimations } from "../../Contraflujo/Desamaq/scrollDesamaq";

  if (typeof window !== "undefined") {
    window.addEventListener("DOMContentLoaded", () => {
      initScrollAnimations();
    });
  }
</script>

<script>
  function setupTabs() {
    const buttons = document.querySelectorAll(".tab-button");
    const contents = document.querySelectorAll(".tab-content");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.getAttribute("data-target");
        if (!target) return;

        // Resetear botones
        buttons.forEach((b) => {
          b.classList.remove("border-[blue-900]", "text-blue-900");
          b.classList.add("border-transparent", "text-gray-500");
          b.setAttribute("aria-selected", "false");
        });

        // Activar botón clickeado
        btn.classList.add("border-[#ca1c1c]", "text-black");
        btn.classList.remove("border-transparent", "text-gray-500");
        btn.setAttribute("aria-selected", "true");

        // Ocultar todos los contenidos
        contents.forEach((content) => {
          content.classList.add("hidden");
          content.classList.remove("block");
        });

        // Mostrar contenido objetivo
        const targetElement = document.getElementById(target);
        if (targetElement) {
          targetElement.classList.remove("hidden");
          targetElement.classList.add("block");
        }
      });
    });
  }

  // Ejecutar en la carga inicial y después de transiciones de View Transitions si se usan
  setupTabs();
  document.addEventListener("astro:after-swap", setupTabs);
</script>

<style>
  .tab-button {
    cursor: pointer;
    outline: none;
  }
  /* Estilo opcional para suavizar la aparición del contenido */
  .tab-content.block {
    animation: fadeIn 0.3s ease-in-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
