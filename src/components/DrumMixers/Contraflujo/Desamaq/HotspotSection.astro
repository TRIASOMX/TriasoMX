<!-- Sección hotspot -->
<section class="py-20">
  <div>
    <div
      class="max-w-7xl mx-auto px-8 space-y-5 flex flex-col items-center justify-center"
    >
      <img src="https://placehold.co/1920x1080/png" alt="Placeholder" />
    </div>
  </div>
</section>

<section class="py-12">
  <div class="max-w-7xl mx-auto px-8 mb-10">
    <div
      class="flex border-b border-gray-200 justify-center"
      role="tablist"
      aria-label="Configuración de tolvas"
    >
      <button
        id="tab-1-trigger"
        class="tab-button px-2 md:px-6 py-0 md:py-3 font-bold text-base md:text-lg border-b-2 border-[#ca1c1c] text-black transition-all"
        data-target="tab-1"
        role="tab"
        aria-selected="true"
        aria-controls="tab-1"
      >
        Con unidad de tolvas, independiente sobre chasis con llantas
      </button>
      <button
        id="tab-2-trigger"
        class="tab-button px-2 md:px-6 py-0 md:py-3 font-bold text-base md:text-lg border-b-2 border-transparent text-gray-500 transition-all"
        data-target="tab-2"
        role="tab"
        aria-selected="false"
        aria-controls="tab-2"
      >
        Con unidad de tolvas montadas sobre el mismo chasis
      </button>
    </div>
  </div>

  <div id="tab-container">
    <div
      id="tab-1"
      class="tab-content block"
      role="tabpanel"
      aria-labelledby="tab-1-trigger"
    >
      <section class="max-w-7xl mx-auto px-8 mb-20">
        <div class="flex justify-center items-center mb-10">
          <h2 class="text-black font-bold text-2xl md:text-4xl text-center">
            Ahorros que usted podrá lograr con la planta de asfalto
          </h2>
        </div>
        <div>
          <DropdownItem panels={desamaqPanels} />
        </div>
      </section>

      <section>
        <div class="w-full flex flex-col font-bold mt-5 lg:mt-0">
          <div class="hidden max-w-7xl px-8 mx-auto lg:flex justify-start">
            <Image
              src={img1}
              alt="Drum mixer on a construction zone"
              class="hero-img lg:w-[70%] rounded-lg"
            />
          </div>
          <div
            class="flex max-w-7xl px-8 mx-auto lg:hidden md:flex justify-center"
          >
            <Image
              src={img1}
              alt="Drum mixer on a construction zone"
              class="lg:w-4/5 rounded-lg"
            />
          </div>

          <div class="bg-[#14427c]">
            <div
              class="max-w-7xl px-8 mx-auto flex flex-col lg:flex-row justify-between items-center py-2"
            >
              <div class="flex flex-col md:flex-row gap-6 lg:w-[40%]">
                <div class="w-full">
                  <h2 class="text-[#f9f9f9] text-base md:text-2xl">
                    Mayor capacidad de movilidad
                  </h2><br />
