<section
  id="tamborMezclador"
  class="w-full select-none min-h-[90vh]"
  aria-label="Tambor Mezclador"
>
  <h2
    class="font-bold text-2xl lg:text-3xl text-black mb-5 uppercase my-2 md:my-10"
  >
    Tambor Mezclador
  </h2>

  <div class="overflow-hidden" id="sliderViewport">
    <div
      id="sliderTrack"
      class="flex transition-transform duration-500 ease-[cubic-bezier(0.4,0,0.2,1)] will-change-transform"
    >
      <div class="w-full shrink-0 space-y-4">
        <div class="card-row-wrapper relative">
          <div
            class="card-row grid grid-cols-1 sm:grid-cols-3 gap-3"
            id="cardRow0"
          >
            <!-- Card 1-A -->
            <div
              class="relative rounded-lg overflow-hidden group cursor-pointer"
              data-card="0-0"
            >
              <div
                class="w-full h-56 sm:h-80 lg:h-96 bg-black/10 overflow-hidden"
              >
                <img
                  src={slider1.src}
                  alt="Roles de carga"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>

              <div
                class="card-darken absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/95 to-transparent opacity-0 transition-opacity duration-700 ease-in-out pointer-events-none"
              >
              </div>

              <div
                class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-3 sm:p-4"
              >
                <span
                  class="font-bold text-white text-sm sm:text-base uppercase tracking-wide leading-tight mb-2"
                >
                  Roles de carga
                </span>

                <button
                  class="mostrar-mas flex items-center gap-1 text-white/80 text-xs hover:text-white transition-colors -m-2 p-2"
                  aria-expanded="false"
                >
                  <svg
                    class="chevron w-3 h-3 transition-transform duration-300"
                    viewBox="0 0 12 12"
                    fill="none"
                  >
                    <path
                      d="M2 4l4 4 4-4"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"></path>
                  </svg>
                  mostrar más
                </button>

                <div
                  class="expandible max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out"
                >
                  <p
                    class="text-white/75 text-xs sm:text-sm leading-relaxed mt-2"
                  >
                    Roles de carga reforzados fabricados en acero forjado,
                    maquinado con precisión y equipados con rodamientos
                    industriales para una rotación del tambor suave y estable.
                  </p>
                </div>
              </div>
            </div>

            <!-- Card 1-B -->
            <div
              class="relative rounded-lg overflow-hidden group cursor-pointer"
              data-card="0-1"
            >
              <div
                class="w-full h-56 sm:h-80 lg:h-96 bg-black/10 overflow-hidden"
              >
                <img
                  src={slider2.src}
                  alt="Variadores de velocidad de giro"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>

              <div
                class="card-darken absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/95 to-transparent opacity-0 transition-opacity duration-700 ease-in-out pointer-events-none"
              >
              </div>

              <div
                class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-3 sm:p-4"
              >
                <span
                  class="font-bold text-white text-sm sm:text-base uppercase tracking-wide leading-tight mb-2"
                >
                  Sistema de ajuste centralizado
                </span>

                <button
                  class="mostrar-mas flex items-center gap-1 text-white/80 text-xs hover:text-white transition-colors -m-2 p-2"
                  aria-expanded="false"
                >
                  <svg
                    class="chevron w-3 h-3 transition-transform duration-300"
                    viewBox="0 0 12 12"
                    fill="none"
                  >
                    <path
                      d="M2 4l4 4 4-4"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"></path>
                  </svg>
                  mostrar más
                </button>

                <div
                  class="expandible max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out"
                >
                  <p
                    class="text-white/75 text-xs sm:text-sm leading-relaxed mt-2"
                  >
                    Equipamos todos los tambores con un sistema centralizado de
                    ajuste de roles de carga, diseñado para una alineación
                    rápida y precisa en campo.
                  </p>
                </div>
              </div>
            </div>

            <!-- Card 1-C -->
            <div
              class="relative rounded-lg overflow-hidden group cursor-pointer"
              data-card="0-2"
            >
              <div
                class="w-full h-56 sm:h-80 lg:h-96 bg-black/10 overflow-hidden"
              >
                <img
                  src={slider3.src}
                  alt="Aros"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>

              <div
                class="card-darken absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/95 to-transparent opacity-0 transition-opacity duration-700 ease-in-out pointer-events-none"
              >
              </div>

              <div
                class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-3 sm:p-4"
              >
                <span
                  class="font-bold text-white text-sm sm:text-base uppercase tracking-wide leading-tight mb-2"
                >
                  Aros
                </span>

                <button
                  class="mostrar-mas flex items-center gap-1 text-white/80 text-xs hover:text-white transition-colors -m-2 p-2"
                  aria-expanded="false"
                >
                  <svg
                    class="chevron w-3 h-3 transition-transform duration-300"
                    viewBox="0 0 12 12"
                    fill="none"
                  >
                    <path
                      d="M2 4l4 4 4-4"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"></path>
                  </svg>
                  mostrar más
                </button>

                <div
                  class="expandible max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out"
                >
                  <p
                    class="text-white/75 text-xs sm:text-sm leading-relaxed mt-2"
                  >
                    Forjados en acero aleado de alta resistencia y maquinados
                    con precisión para garantizar un soporte confiable y una
                    operación silenciosa y uniforme.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- MÓVIL INDICADORES -->
          <div
            class="card-dots flex justify-center gap-1.5 mt-2 sm:hidden"
            data-row="0"
          >
            <span class="card-dot w-2 h-2 rounded-full bg-gray-800"></span>
            <span class="card-dot w-1.5 h-1.5 mt-0.5 rounded-full bg-gray-300"
            ></span>
            <span class="card-dot w-1.5 h-1.5 mt-0.5 rounded-full bg-gray-300"
            ></span>
          </div>
        </div>

        <!-- Bloque RAP slide 1 -->
        <div
          class="rounded-xl bg-[#727272] p-6 flex flex-col sm:flex-row items-center gap-6 min-h-56 sm:min-h-80 lg:min-h-80"
        >
          <div class="flex-1 min-w-0">
            <h3
              class="font-extrabold text-white text-2xl md:text-3xl uppercase tracking-wide mb-2"
            >
              Collar de RAP
            </h3>
            <p class="text-white/80 text-sm mb-1">
              Nuestro sistema de RAP puede incorporar
            </p>
            <p class="text-white font-bold text-base md:text-lg mb-3">
              hasta 30% <span class="font-normal text-sm text-white/80"
