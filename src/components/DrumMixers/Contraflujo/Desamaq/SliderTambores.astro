                  </p>
                </div>
              </div>
            </div>
          </div>

          <div
            class="card-dots flex justify-center gap-1.5 mt-2 sm:hidden"
            data-row="1"
          >
            <span class="card-dot w-2 h-2 rounded-full bg-gray-800"></span>
            <span class="card-dot w-1.5 h-1.5 mt-0.5 rounded-full bg-gray-300"
            ></span>
            <span class="card-dot w-1.5 h-1.5 mt-0.5 rounded-full bg-gray-300"
            ></span>
          </div>
        </div>

        <!-- Bloque RAP slide 2 -->
        <div
