              Saber más
            </a>
          </div>

          <div
            class="w-full sm:w-48 md:w-56 lg:w-64 h-40 sm:h-48 md:h-56 flex items-center justify-center shrink-0"
          >
            <img
              src={bigSlider2.src}
              alt="Tolvas de RAP"
              class="max-w-full max-h-full object-contain"
            />
          </div>
        </div>
      </div>

      <div class="w-full shrink-0 space-y-4">
        <div class="card-row-wrapper relative">
          <div class="card-row grid grid-cols-1 sm:grid-cols-3 gap-3">
            <!-- Card 3-A -->
            <div
              class="relative rounded-lg overflow-hidden group cursor-pointer"
              data-card="2-0"
            >
              <div
