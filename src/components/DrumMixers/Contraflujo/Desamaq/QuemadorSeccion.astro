---
import SmartVideo from "../../../unitComponents/SmartVideo";
import poster1 from "../../../../assets/images/Burners/Gallery/B1.webp";
import QuemadorSlider from "../../QuemadorSlider";
import slide2 from "../../../../assets/images/Burners/preHeat.webp";

const slides = [
  {
    title: "Precalentador de combustible",
    description:
      "Con los precalentadores reducimos la viscosidad del combustible, garantizando una atomización adecuada y una combustión limpia, sin demoras ni fuentes de calor externas.",
    image: slide2.src,
    bgColor: "#fffaea",
    titleColor: "#000000",
    descriptionColor: "#000000",
    extraContent: `
      <h3 class="font-bold text-sm">Problemas causados por no precalentar los combustibles de bajo costo:</h3>
      <ul class="list-disc pl-5">
        <li class="text-sm">Las microgotas sin quemar provocan una pérdida considerable de combustible.</li>
        <li class="text-sm">La mezcla asfáltica se contamina con combustible sin quemar.</li>
        <li class="text-sm">Esta contaminación reduce significativamente la vida útil del pavimento asfáltico.</li>
        <li class="text-sm">La atmósfera se ve afectada por los gases generados por una combustión incompleta.</li>
      </ul>
    `,
  },
];
---

<section class="min-h-[70vh] mt-6 md:mt-14 flex justify-center">
  <!-- Sección arriba -->
  <div
    class="max-w-7xl mx-auto px-8 grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-16 items-center"
  >
    <div class="w-full col-span-1 flex flex-col gap-6">
      <div>
        <h2
          class="uppercase text-2xl md:text-5xl font-extrabold text-[#393939] max-w-[40ch]"
        >
          Quemadores de aire total
        </h2>

        <div class="h-1 bg-[#ca1c1c] w-1/2 my-5"></div>
      </div>
      <div class="flex flex-col">
        <p class="max-w-[30ch] text-base md:text-lg">
          Desde 6 a 125 millones de Btu/Hr, con precalentador, filtro y más
        </p>
      </div>
      <div class="flex flex-col w-full max-w-[600px] gap-3">
        <div
          class="bg-white w-full rounded-2xl flex justify-center items-center"
        >
          <div class="mx-auto py-4">
            <p class="font-bold text-xl md:text-2xl">Aire 100% regulado</p>
          </div>
        </div>
        <div
          class="bg-[#393939] rounded-2xl w-full flex justify-center items-center"
        >
          <div class="mx-auto py-4">
            <p class="font-bold text-white text-xl md:text-2xl">
              Bajas emisiones de NOx
            </p>
          </div>
        </div>
      </div>
    </div>
    <div
      class="flex items-center justify-center lg:justify-end w-full col-span-1"
    >
      <SmartVideo
        client:visible
        src="/Videos/Webm/burnerVideo.webm"
        aspectRatio="11/9"
        width="100%"
        poster={poster1.src}
        isLoop={true}
        autoplayOnMobile={false}
      />
    </div>
  </div>
  <!-- Sección 2 -->
</section>

<!-- Sección sliders -->

<section class="pt-10 w-full self-center">
  <div class="max-w-7xl mx-auto px-8 space-y-2">
    <h2 class="text-[#ca1c1c] font-bold text-2xl md:text-4xl">
      Flama, mezcla y calidad consistente
    </h2>
    <p>Menor consumo de combustible que cualquier otra planta de asfalto</p>
  </div>

  <div class="max-w-7xl mx-auto px-8 py-5">
    <QuemadorSlider slides={slides} client:visible />
  </div>
</section>

<!-- Sección 3 -->
<section>
  <div
    class="max-w-7xl mx-auto px-8 flex flex-col items-center justify-center py-10"
  >
    <h2
      class="text-black font-bold text-2xl md:text-4xl text-center lg:text-left"
    >
      Sólo el dueño de otra planta de asfalto Triaso,
      <br />
      igual de moderna, le puede hacer competencia.
    </h2>
  </div>
</section>
