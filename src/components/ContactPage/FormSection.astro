---
import ContactForm from "./ContactForm";
import { CONTACT_EMAIL } from "../../assets/data/contacto";

// El número se muestra tal cual; el enlace se arma solo con los dígitos (incluir lada de país).
const whatsapps = ["+52 (618) 170 3580", "+52 (618) 183 0730", "+52 (618) 109 7672"];

const phones = [
  "+52 (618) 170 3580",
  "+52 (618) 183 0730",
  "+52 (618) 812 1203",
  "+52 (618) 812 2867",
  "+52 (618) 813 8787",
  "+52 (618) 812 1190",
  "+52 (618) 812 8949",
  "+52 (618) 690 3000",
  "+52 (618) 812 9966",
];

const digits = (n: string) => n.replace(/\D/g, "");
---

<section class="max-w-7xl mx-auto px-8 mt-16 md:mt-24">
  <!-- Encabezado -->
  <div class="flex flex-col">
    <h1 class="font-bold text-2xl md:text-4xl text-blueMain uppercase">
      Contáctanos
    </h1>
    <div class="flex flex-row mt-2">
      <div class="w-20 h-0.5 bg-redBg"></div>
      <div class="w-20 h-0.5 bg-gray-300"></div>
    </div>
    <p class="mt-4 max-w-2xl text-sm md:text-base text-grisP">
      Estamos para ayudarte. Escríbenos por el formulario o contáctanos
      directamente.
    </p>
  </div>

  <div
    class="mt-10 grid grid-cols-1 lg:grid-cols-2 items-start gap-8 lg:gap-12"
  >
    <!-- Formulario -->
    <div class="w-full">
      <ContactForm client:visible />
    </div>

    <!-- Teléfonos -->
    <div class="flex flex-col gap-8">
      <!-- WhatsApp -->
      <div class="flex flex-col gap-4">
        <h2 class="text-xl font-bold text-blueMain md:text-2xl">WhatsApp</h2>
        <ul class="grid grid-cols-1 gap-3 sm:grid-cols-[repeat(auto-fill,minmax(16rem,1fr))]">
          {
            whatsapps.map((w) => (
              <li>
                <a
                  href={`https://wa.me/${digits(w)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex h-full items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition-colors hover:border-[#075e54]"
                >
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#075e54] text-white">
                    <svg class="h-5 w-5" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
                      <path d="M26.576 5.363c-2.69-2.69-6.406-4.354-10.511-4.354-8.209 0-14.865 6.655-14.865 14.865 0 2.732 0.737 5.291 2.022 7.491l-0.038-0.070-2.109 7.702 7.879-2.067c2.051 1.139 4.498 1.809 7.102 1.809h0.006c8.209-0.003 14.862-6.659 14.862-14.868 0-4.103-1.662-7.817-4.349-10.507l0 0zM16.062 28.228h-0.005c-0 0-0.001 0-0.001 0-2.319 0-4.489-0.64-6.342-1.753l0.056 0.031-0.451-0.267-4.675 1.227 1.247-4.559-0.294-0.467c-1.185-1.862-1.889-4.131-1.889-6.565 0-6.822 5.531-12.353 12.353-12.353s12.353 5.531 12.353 12.353c0 6.822-5.53 12.353-12.353 12.353h-0zM22.838 18.977c-0.371-0.186-2.197-1.083-2.537-1.208-0.341-0.124-0.589-0.185-0.837 0.187-0.246 0.371-0.958 1.207-1.175 1.455-0.216 0.249-0.434 0.279-0.805 0.094-1.15-0.466-2.138-1.087-2.997-1.852l0.010 0.009c-0.799-0.74-1.484-1.587-2.037-2.521l-0.028-0.052c-0.216-0.371-0.023-0.572 0.162-0.757 0.167-0.166 0.372-0.434 0.557-0.65 0.146-0.179 0.271-0.384 0.366-0.604l0.006-0.017c0.043-0.087 0.068-0.188 0.068-0.296 0-0.131-0.037-0.253-0.101-0.357l0.002 0.003c-0.094-0.186-0.836-2.014-1.145-2.758-0.302-0.724-0.609-0.625-0.836-0.637-0.216-0.010-0.464-0.012-0.712-0.012-0.395 0.010-0.746 0.188-0.988 0.463l-0.001 0.002c-0.802 0.761-1.3 1.834-1.3 3.023 0 0.026 0 0.053 0.001 0.079l-0-0.004c0.131 1.467 0.681 2.784 1.527 3.857l-0.012-0.015c1.604 2.379 3.742 4.282 6.251 5.564l0.094 0.043c0.548 0.248 1.250 0.513 1.968 0.740l0.149 0.041c0.442 0.140 0.951 0.221 1.479 0.221 0.303 0 0.601-0.027 0.889-0.078l-0.031 0.004c1.069-0.223 1.956-0.868 2.497-1.749l0.009-0.017c0.165-0.366 0.261-0.793 0.261-1.242 0-0.185-0.016-0.366-0.047-0.542l0.003 0.019c-0.092-0.155-0.340-0.247-0.712-0.434z" />
                    </svg>
                  </span>
                  <span class="flex flex-col">
                    <span class="text-sm text-grisP">Enviar mensaje</span>
                    <span class="whitespace-nowrap font-semibold text-grisT group-hover:text-[#075e54]">
                      {w}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Llamadas -->
      <div class="flex flex-col gap-4">
        <h2 class="text-xl font-bold text-blueMain md:text-2xl">Teléfonos</h2>
        <ul class="grid grid-cols-1 gap-x-6 sm:grid-cols-2">
          {
            phones.map((p) => (
              <li class="border-b border-gray-200">
                <a
                  href={`tel:+${digits(p)}`}
                  class="group flex items-center gap-3 py-3"
                >
                  <svg
                    class="h-5 w-5 shrink-0 text-redBg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
                    ></path>
                  </svg>
                  <span class="whitespace-nowrap font-semibold text-blueSecondary group-hover:underline">
                    {p}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Correo -->
      <div class="flex flex-col gap-4">
        <h2 class="text-xl font-bold text-blueMain md:text-2xl">Correo</h2>
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="group flex items-center gap-3 py-3 border-b border-gray-200"
        >
          <svg
            class="h-5 w-5 shrink-0 text-redBg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
            ></path>
          </svg>
          <span class="font-semibold text-blueSecondary group-hover:underline break-all">
            {CONTACT_EMAIL}
          </span>
        </a>
      </div>

      <!-- Sitio de Estados Unidos -->
      <div
        class="flex flex-col gap-4 rounded-xl border border-gray-200 bg-white p-5 shadow-sm"
      >
        <p class="font-semibold italic text-grisT">
          ¿Buscas el sitio de Estados Unidos?
        </p>
        <a
          href="https://www.triasous.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-row items-center gap-4 font-semibold text-blueMain hover:underline"
        >
          <svg
            class="w-[22px] h-[22px] text-redBg shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m-9 9h18"
            ></path>
          </svg>
          www.triasous.com
        </a>
      </div>
    </div>
  </div>
</section>
