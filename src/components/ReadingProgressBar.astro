---
---
<div class="progress-track" id="reading-progress-track">
  <div class="progress-fill" id="reading-progress-fill"></div>
</div>

<style>
  .progress-track {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 4px;
    z-index: 60;
    background: transparent;
    pointer-events: none;
  }

  .progress-fill {
    width: 100%;
    height: 100%;
    background-color: var(--progress-bar-color, #14427c);
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }
</style>

<script>
  const fill = document.getElementById("reading-progress-fill") as HTMLElement | null;
  let ticking = false;

  function updateProgress(): void {
    ticking = false;
    if (!fill) return;

    const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
    const scrollHeight = document.documentElement.scrollHeight;
    const clientHeight = document.documentElement.clientHeight;
    const scrollable = scrollHeight - clientHeight;

    // scrollable <= 0 cuando la página es más corta que el viewport
    const ratio = scrollable > 0 ? scrollTop / scrollable : 0;
    const clamped = Math.min(Math.max(ratio, 0), 1);

    fill.style.transform = `scaleX(${clamped})`;
  }

  function onScroll(): void {
    if (!ticking) {
      ticking = true;
      window.requestAnimationFrame(updateProgress);
    }
  }

  updateProgress();
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("load", updateProgress);

  if (typeof ResizeObserver !== "undefined") {
    const resizeObserver = new ResizeObserver(() => {
      window.requestAnimationFrame(updateProgress);
    });
    resizeObserver.observe(document.body);
  }
</script>
