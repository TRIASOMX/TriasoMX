---
import HeroImage from "../../../assets/images/Casetas/remolcable.webp";
import HeroComponentV2AstroComponent from "../../unitComponents/HeroComponentV2.astro";
import OdometerMontable from "./OdometerRemolcable.tsx";
---

<!-- Hero -->
<section>
  <HeroComponentV2AstroComponent
    title="Caseta Remolcable"
    text="Todos los procesos son controlados desde una consola de control remolcable, ideal para reubicaciones rápidas y transporte sencillo. Para que su personal opere el equipo, con total comodidad; de forma manual o automática con nuestro más avanzado sistema de control Traso Relief™. Por lo que garantizamos su gran productividad, calidad de mezcla y operación libre de problemas."
    titleColor="white"
    textColor="white"
    heroImage={HeroImage.src}
    btns={true}
    bgColor="#1e1e1e"
  >
    <div class="flex flex-row justify-center items-center gap-10">
      <a
        class="font-thing text-white text-xl lg:text-2xl"
        href="/Casetas/CasetaMontable">Montable</a
      >
      <a
        class="font-bold underline text-white text-xl lg:text-2xl"
        href="/Casetas/CasetasRemolcables">Remolcable</a
      >
    </div>
  </HeroComponentV2AstroComponent>
</section>

<section class="w-full flex justify-center items-center min-h-[90vh]">
  <OdometerMontable client:only />
</section>
