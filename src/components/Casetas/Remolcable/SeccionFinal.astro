---
import { Image } from "astro:assets";
import img2 from "../../../../public/consola1.webp";
import SecondWhatsBtn from "../../unitComponents/SecondWhatsBtn.astro";
import PlanosMontable from "./PlanosMontable";
import Slider from "../../AsphaltStorage/Slider";
import CTASection1 from "../../unitComponents/CTASection1.astro";

const slides = [
  {
    id: 1,
    title: "Amperímetros ",
    text: "Amperímetros para monitoreo de los principales motores de la planta",
    image: "https://placehold.co/600x400/png",
  },
  {
    id: 2,
    title: "Variadores de frecuencia",
    text: "Dosificación de asfalto y de agregados por variadores de velocidad, de trabajo pesado ",
    image: "https://placehold.co/600x400/png",
  },
  {
    id: 3,
    title: "Botonera",
    text: "Sistema de arranque y de paro de motores en cascada para evitar errores de operación.",
    image: "https://placehold.co/600x400/png",
  },
  {
    id: 4,
    title: "Apagado de emergencia",
    text: "Sistema de paro general de emergencia, con bloqueo para mantenimientos ",
    image: "https://placehold.co/600x400/png",
  },
  {
    id: 5,
    title: "Controles",
    text: "Control y monitoreo por instrumentación electrónica, de fácil visualización, tipo industrial para: Quemador, Damper y Apertura de bacha",
    image: "https://placehold.co/600x400/png",
  },
  {
    id: 6,
    title: "Variadores de frecuencia",
    text: "Dosificación de asfalto y de agregados por variadores de velocidad, de trabajo pesado ",
    image: "https://placehold.co/600x400/png",
  },
];
---

<section>
  <div class="max-w-7xl mx-auto flex flex-col px-8">
    <div class="lg:w-1/2">
      <h1 class="font-bold text-xl md:text-4xl">Operación sencilla</h1><br />
      <p class="text-sm md:text-base">
        Nuestro sistema de control está diseñado para ser operado por una sola
        persona, reduciendo costos de mano de obra y simplificando la operación
        de la planta
      </p>
    </div>
  </div>

  <div class="w-full flex flex-col font-bold mt-12">
    <div
      class="relative z-10 max-w-7xl px-8 mx-auto flex justify-start -mb-6 lg:mb-0"
    >
      <Image
        src={img2}
        alt="Baghouse"
        class="hero-img lg:w-4/5 rounded-lg"
        fetchpriority="high"
        loading="lazy"
      />
    </div>
    <div class="bg-[#100f0d]">
      <div
        class="max-w-7xl px-8 mx-auto flex flex-col lg:flex-row justify-between items-center py-12 lg:py-2"
      >
        <div class="flex flex-col md:flex-row gap-6 lg:w-[40%]">
          <div class="w-full">
            <h2 class="text-[#f9f9f9] text-lg md:text-2xl">
              Operación manual cuando se requiera
            </h2><br />
            <p
              class="text-[#f4f5f6] text-sm md:text-base text-justify font-normal"
            >
              Entendemos la importancia de tener control total de la operación.
              Por eso, nuestro sistema aparte del modo de operación automática,
              incluye un modo de operación completamente manual. No dependemos
              de una configuración totalmente automatizada: si algún componente
              deja de funcionar, la planta puede seguir operando manualmente sin
              interrumpir la producción.
            </p>
          </div>
        </div>
        <div class="w-full hidden lg:flex md:w-auto">
          <Image
            src="https://placehold.co/600x400/png"
            width={600}
            height={400}
            alt="Baghouse cleaning system"
            class="side-img rounded-2xl will-change-transform"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section>
  <Slider slides={slides} dark={true} client:only />
  <div class="max-w-7xl mx-auto px-8 py-5">
    <div class="flex justify-center items-center">
      <div class="flex flex-col">
        <h1 class="text-2xl md:text-4xl">
          Con <span class="italic font-bold">Triaso</span>
        </h1>
        <p class="font-bold text-[#14427c] text-xl md:text-3xl">
          conviértase en el proveedor preferido de mezcla asfáltica
        </p>
        <p class="font-bold text-[#14427c] text-xl md:text-3xl">
          en todos los proyectos de pavimentación de su región.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="py-2 md:py-10">
  <CTASection1 />

  <div class="max-w-7xl mx-auto px-8 flex items-center justify-center">
    <h1
      class="text-2xl md:text-3xl font-semibold my-6 bg-gradient-to-r from-black to-[#2325a5] bg-clip-text text-transparent"
    >
      Invertir en calidad siempre tiene sentido.
    </h1>
  </div>
</section>

<section>
  <PlanosMontable client:only />
</section>

<script>
  import { initScrollAnimations } from "../scrollAnimationCaseta";

  if (typeof window !== "undefined") {
    window.addEventListener("DOMContentLoaded", () => {
      initScrollAnimations();
    });
  }
</script>
