---
import { Image } from "astro:assets";
import img2 from "../../assets/images/ColdMix/pugmill2.webp";
import TwoColumnSection from "../unitComponents/TwoColumnSection.astro";
import AcordeonItem from "../unitComponents/AcordeonItem";
import binUnit1 from "../../assets/images/BinUnits/binUnit1.webp";
import Tred from "../../assets/images/AsphaltStorage/redT.webp";
import CMHigh from "../../assets/images/ColdMix/CMHigh.webp";
import PlaMFDscC1 from "../../assets/images/ColdMix/PlaMFDscC1.webp";
import SmartVideo from "../unitComponents/SmartVideo";
import Whatsbtn from "../unitComponents/Whatsbtn.astro";
import DropdownComponent from "../unitComponents/DropdownComponent.astro";
import Slider from "../AsphaltStorage/Slider";
import ProvBU2 from "../../assets/images/BinUnits/ProvBU2.webp";
import ProvBU4 from "../../assets/images/BinUnits/ProvBU4.webp";
import FineVibrator from "../../assets/images/BinUnits/FineVibrator.webp";
import sidePanels from "../../assets/images/SidePanels/TolvasFE.webp";
import paletas1 from "../../assets/images/ColdMix/pugmill2.webp";
import paletas2 from "../../assets/images/ColdMix/pugmill3.webp";
import paletas3 from "../../assets/images/ColdMix/CMG8.webp";

const pugmillCards = [
  {
    image: paletas1,
    title: "Paletas mezcladoras",
    paragraphs: [
      "Las paletas de mezclado del pugmill aseguran una mezcla asfáltica uniforme y de alta calidad. Sus paletas de mezcla de hierro fundido son totalmente intercambiables y están diseñadas para una larga durabilidad.",
      "Fabricadas en materiales de alta resistencia al desgaste, como acero Hardox o hierro fundido, son totalmente intercambiables y aptas para trabajo pesado con agregados abrasivos. Durante la operación se forma una capa protectora interna que reduce el desgaste y prolonga la vida útil del equipo.",
    ],
  },
  {
    image: paletas2,
    title: "Ejes sincronizados",
    paragraphs: [
      "El pugmill cuenta con dos ejes sincronizados accionados por un sistema de engranes para lograr un mezclado equilibrado y eficiente. Lo que garantiza la correcta incorporación de los materiales y una distribución homogénea de la emulsión asfáltica, evitando acumulaciones.",
    ],
  },
  {
    image: paletas3,
    title: "Mantenimiento sencillo",
    paragraphs: [
      "Con un mantenimiento sencillo y una construcción robusta, el pugmill ofrece un desempeño de mezclado confiable incluso en condiciones de trabajo exigentes.",
    ],
  },
];

const slides = [
  {
    id: 1,
    title: "Vibrador en tolva de finos para flujo continuo de material",
    text: "Equipada con un vibrador en la tolva de finos para evitar la acumulación de material causada por la humedad y asegurar un flujo continuo de alimentación.",
    image: FineVibrator.src,
  },
  {
    id: 2,
    title: "Sistemas de dosificación de precisión en unidades de tolvas",
    text: "Desde nuestros inicios como fabricantes de plantas de asfalto, identificamos un problema en la mayoría de las plantas del mercado: la dosificación de agregados basada únicamente en peso y no en volumen. Este enfoque limita la precisión del diseño de mezcla, ya que el peso de los agregados varía con la humedad, mientras que el volumen se mantiene constante.",
    image: ProvBU2.src,
  },
  {
    id: 3,
    title: "Sistemas de dosificación por volumen preciso",
    text: "Nuestras tolvas están equipadas con sistemas de dosificación avanzados, diseñados para ofrecer la máxima precisión y confiabilidad. Garantizamos un flujo y una distribución exacta del material, cumpliendo con las necesidad de proyectos con especificaciones de exactitud.",
    image: ProvBU4.src,
  },
  {
    id: 4,
    title: "Flancos esteticos",
    text: "Para requerimientos especiales, ya sea que necesite una solución estándar o un diseño a la medida.",
    image: sidePanels.src,
  },
];
---

<!-- Sección sliders -->
<section>
  <Slider slides={slides} dark={true} client:only />
</section>

<div class="w-full font-bold flex flex-col justify-center items-center">
  <div
    class="max-w-[2400px] grid grid-cols-1 md:grid-cols-5 gap-10 items-start justify-center"
  >
    <div class="col-span-2 flex justify-start md:justify-center">
      <Image
        src={binUnit1}
        alt="Precision Dosing Systems in Cold Mix Asphalt Plants"
        class="w-3/4 md:w-full"
      />
    </div>
    <div
      class="col-span-3 flex flex-col items-start h-full justify-center lg:pr-52 pr-2 md:pl-0 pl-2"
    >
      <div class="w-full flex flex-col gap-3 md:gap-6">
        <AcordeonItem
          client:only
          title="Sensores de alta precisión"
          content="El sistema puede equiparse con sensores opcionales que monitorean los niveles de material en tiempo real, permitiendo un control preciso de la dosificación y evitando derrames o faltantes."
        />
        <AcordeonItem
          client:only
          title="Dosificación ajustable"
          content="Los operadores pueden modificar la dosificación para adaptarse a una amplia gama de materiales, desde agregados finos hasta rocas de mayor tamaño o arena."
        />
        <AcordeonItem
          client:only
          title="Distribución constante del material"
          content="Garantiza una dosificación pareja para mantener una mezcla equilibrada en procesos posteriores, como mezclado o trituración."
        />
        <AcordeonItem
          client:only
          title="Controles automatizados"
          content="Equipado con controladores lógicos programables (PLC) y con nuestra versión más reciente, Triaso 8.0, el sistema puede automatizarse completamente para ofrecer un desempeño constante y repetible en distintos proyectos."
        />
        <AcordeonItem
          client:only
          title="Mecanismo anti-obstrucción"
          content="Los chutes y compuertas están diseñados especialmente para minimizan el riesgo de bloqueos, asegurando un flujo de material continuo y sin interrupciones."
        />
        <AcordeonItem
          client:only
          title="Operación de bajo consumo energético"
          content="Diseñado para optimizar el consumo de energía, reduciendo los costos operativos sin comprometer el rendimiento."
        />
      </div><br />
      <p class="text-sm md:text-lg font-thin text-grisT text-justify px-4">
        Estas características convierten nuestros sistemas de dosificación en un
        componente esencial para proyectos que requieren un manejo de materiales
        preciso y eficiente.
      </p><br />
    </div>
  </div>

  <TwoColumnSection
    leftBg="bg-redBg"
    rightBg="bg-blueMain"
    imageSrc={Tred.src}
    imageAlt="Red T icon"
    imageWidth="150px"
  >
    <div slot="left" class="flex flex-col justify-center gap-3">
      <h1 class="text-xl md:text-2xl">
        Configuraciones para cualquier proyecto y necesidades
      </h1>
      <p class="text-sm md:text-lg">
        Nuestras plantas de mezcla en frío pueden equiparse con detectores de
        flujo, vibradores, divisores de tolvas, indicadores de nivel,
        extensiones y rejillas grizzly. Estas opciones permiten adaptar la
        planta a distintos requisitos de manejo de materiales, garantizando
        eficiencia y confiabilidad en cualquier proyecto.
      </p>
    </div>
    <div
      slot="right"
      class="flex flex-col justify-center lg:pl-3 md:pl-5 w-full"
    >
      <h1 class="text-xl md:text-2xl">Servicio al cliente 24/7</h1><br />
      <div class="text-sm lg:text-lg md:text-lg">
        <p>
          Sabemos que la operación de muchos equipos depende de la confiabilidad
          de su planta de asfalto, nuestro equipo está disponible las 24 horas,
          listo para ayudarte en cualquier momento, incluso fines de semana y
          días festivos.
        </p>
      </div><br />
      <Whatsbtn />
    </div>
  </TwoColumnSection>

  <div class="w-full md:w-3/4 max-w-7xl mx-auto px-8 py-10">
    <SmartVideo
      client:visible
      src="/Videos/Webm/PGMC.webm"
      poster={img2.src}
      isLoop={false}
      autoplayOnMobile={false}
    />
  </div>

  <div>
    <div class="px-2">
      <DropdownComponent
        title="Descubra la ingeniería detrás de nuestro pugmill"
      >
        <div class="flex flex-col space-y-5">
          <p>
            El pugmill es un componente fundamental en las plantas de mezcla en
            frío, diseñado eficientemente para hacer una variedad de
            mezclas—incluyendo agregados y emulsión asfáltica. Su fabricación
            extra-reforzada, de trabajo pesado garantiza una operación estable y
            un rendimiento confiable con el paso del tiempo.
          </p>
          <p>
            El proceso de mezclado del pugmill permite una homogeneización
            precisa de los agregados, siendo perfecto para una amplia gama de
            aplicaciones que requieren una mezcla en frío de alta calidad. Con
            un mantenimiento sencillo y un diseño fácil de operar, nuestro
            pugmill ofrece una vida prolongada y económica incluso en entornos
            de trabajo exigentes, no es solo una promesa, lo respaldamos con dos
            años de garantía, la más alta en el mercado.
          </p>
        </div>
      </DropdownComponent>
    </div>
  </div>

  <!-- cards: componentes clave del pugmill -->
  <section class="w-full max-w-7xl mx-auto px-4 md:px-8 mt-6 md:mt-12">
    <div class="mb-6 md:mb-10">
      <h2 class="text-xl md:text-3xl text-grisT">
        Componentes clave del pugmill
      </h2>
      <div class="mt-2 h-1 w-16 rounded-full bg-redBg"></div>
    </div>

    <ul
      class="pugmill-cards flex md:grid md:grid-cols-3 gap-5
             overflow-x-auto md:overflow-visible
             snap-x snap-mandatory scroll-smooth
             -mx-4 px-4 md:mx-0 md:px-0 pb-4 md:pb-0"
    >
      {
        pugmillCards.map((card) => (
          <li class="snap-center shrink-0 w-[82%] sm:w-[60%] md:w-full list-none">
            <details class="pugmill-card group h-full bg-white rounded-2xl border border-black/5 shadow-sm transition-shadow duration-300 hover:shadow-lg open:shadow-lg overflow-hidden">
              <summary class="relative list-none cursor-pointer select-none [&::-webkit-details-marker]:hidden">
                <div class="relative w-full h-[300px] md:h-[340px] overflow-hidden bg-gray-100">
                  <Image
                    src={card.image}
                    alt={`Pugmill de planta de mezcla en frío — ${card.title}`}
                    width={600}
                    height={400}
                    class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105 group-open:scale-105"
                  />

                  {/* Degradado base (card cerrada) */}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/25 to-transparent transition-opacity duration-300 group-open:opacity-0" />

                  {/* Panel de contenido revelado (dentro de la imagen) */}
                  <div class="pugmill-panel absolute inset-0 flex flex-col justify-end gap-2 p-4 md:p-5 overflow-y-auto bg-black/80 backdrop-blur-[2px] opacity-0 pointer-events-none transition-opacity duration-300 group-open:opacity-100 group-open:pointer-events-auto">
                    <p class="text-sm md:text-base font-bold text-white">
                      {card.title}
                    </p>
                    {card.paragraphs.map((text) => (
                      <p class="text-xs md:text-sm leading-relaxed text-gray-100">
                        {text}
                      </p>
                    ))}
                  </div>

                  {/* Barra de título (card cerrada) */}
                  <div class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-3 p-4 md:p-5 transition-opacity duration-300 group-open:opacity-0 group-open:pointer-events-none">
                    <h3 class="text-base md:text-lg font-bold text-white drop-shadow-md">
                      {card.title}
                    </h3>
                  </div>

                  {/* Botón +/x */}
                  <span
                    class="absolute top-3 right-3 shrink-0 grid place-items-center w-9 h-9 rounded-full bg-blueMain text-white shadow-md transition-transform duration-300 group-open:rotate-45"
                    aria-hidden="true"
                  >
                    <svg
                      class="w-5 h-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                    >
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </span>
                </div>
              </summary>
            </details>
          </li>
        ))
      }
    </ul>

    <p class="md:hidden mt-3 text-center text-xs font-medium text-grisP">
      Desliza para ver más componentes →
    </p>
  </section>

  <div
    class="max-w-[2400px] grid grid-cols-1 md:grid-cols-3 justify-center items-center gap-4 mt-10 mb-5 h-full"
  >
    <div class="flex items-center justify-start col-span-1">
      <Image
        src={PlaMFDscC1}
        alt="Pugmill on top of the system"
        class="w-[70%]"
      />
    </div>
    <div
      class="grid grid-cols-2 md:grid-cols-3 col-span-2 justify-center items-start gap-10 md:gap-20 px-8 bg-bgBeige p-6 rounded-l-2xl"
    >
      <div
        class="flex flex-col items-start justify-center text-grisT md:text-base lg:text-lg text-sm"
      >
        <h2>Capacidad de</h2>
        <h1 class="text-black text-lg md:text-2xl">0.75 metros cúbicos</h1>
        <h2>de material</h2>
      </div>
      <div
        class="flex flex-col items-start justify-center text-grisT md:text-base lg:text-lg text-sm"
      >
        <h1 class="text-black text-lg md:text-2xl">Apertura automática</h1>
        <h2>controlada por tiempo mediante un</h2>
        <h1 class="text-black text-lg md:text-2xl">temporizador.</h1>
      </div>
      <div
        class="flex flex-col items-start justify-center text-grisT md:text-base lg:text-lg text-sm"
      >
        <h1 class="text-black text-lg md:text-2xl">Control integrado</h1>
        <h2>en la consola centraliza toda la operación del sistema.</h2>
      </div>
      <div
        class="flex flex-col items-start justify-center text-grisT md:text-base lg:text-lg text-sm"
      >
        <h1 class="text-black text-lg md:text-2xl">Apertura neumática</h1>
        <h2>con</h2>
        <h1 class="text-black text-lg md:text-2xl">gatillo de doble efecto</h1>
        <h2>garantiza una descarga controlada y eficiente.</h2>
      </div>
      <div
        class="flex flex-col items-start justify-center text-grisT md:text-base lg:text-lg text-sm"
      >
        <h1 class="text-black text-lg md:text-2xl">
          Apertura automatica o manual
        </h1>
        <h2>permite la operación deseada.</h2>
      </div>
      <div
        class="flex flex-col items-start justify-center text-grisT md:text-base lg:text-lg text-sm"
      >
        <h1 class="text-black text-lg md:text-2xl">
          Compresor de 7.5 <br />HP con un tanque de aire de 293 litros
        </h1>
        <h2>suministra el aire para toda la operación neumática.</h2>
      </div>
    </div>
  </div>
  <div>
    <div
      class="w-full bg-blueMain px-4 lg:px-32 grid grid-cols-1 md:grid-cols-2 py-10 mb-5 items-center gap-6"
    >
      <div class="w-full flex justify-center">
        <Image
          src={CMHigh}
          alt="Bin units connected to trucks"
          class="w-full md:w-4/5 lg:w-3/5 rounded-2xl"
        />
      </div>
      <div class="w-full">
        <h1 class="text-2xl md:text-4xl text-white">
          Equipo altamente portátil
        </h1><br />
        <p class="text-sm md:text-lg text-grisSubP">
          Entendemos la importancia de poner tu equipo en operación lo antes
          posible. El equipo Triaso está diseñado para una instalación rápida y
          un arranque inmediato, reduciendo tiempos muertos y permitiendo
          iniciar producción cuanto antes.
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  .pugmill-cards,
  .pugmill-panel {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .pugmill-cards::-webkit-scrollbar,
  .pugmill-panel::-webkit-scrollbar {
    display: none;
  }
  .pugmill-card > summary::marker,
  .pugmill-card > summary::-webkit-details-marker {
    display: none;
  }
</style>
