---
import Layout from "../layouts/Layout.astro";
import OdometerDrum from "../components/DrumMixers/OdometerDrum";
import DrumMixPlanos from "../components/DrumMixers/DrumMixPlanos";
import HeroComponentV1 from "../components/unitComponents/HeroComponentV1.astro";
import DropdownComponent from "../components/unitComponents/DropdownComponent.astro";
import OsDrumSection from "../components/DrumMixers/OsDrumSection.astro";
import StackedInfoCards from "../components/unitComponents/StackedInfoCards.astro";
import HotspotSection from "../components/DrumMixers/HotspotSection.astro";
import QuemadorSeccion from "../components/DrumMixers/QuemadorSeccion.astro";
import BolsasSeccion from "../components/DrumMixers/BolsasSeccion.astro";
import hero2 from "../assets/images/DrumMixers/Contraflujo/Cpro.webp";
import UltimaSeccion from "../components/DrumMixers/UltimaSeccion.astro";
import SliderTamborCom from "../components/DrumMixers/SliderTamborCom.astro";

const cards = [
  {
    title:
      "La planta de asfalto más robusta, moderna y equipada de Latinoamérica es mexicana",
    text: "",
    bg: "#d13c3c",
    textColor: "#ffffff",
  },
  {
    title:
      "Con una configuración ideal para trabajo pesado y condiciones variables la planta de asfalto está completamente equipada.",
    text: "",
    bg: "#14427c",
    textColor: "#ffffff",
  },
  {
    title:
      "Operación total manual o automática para un control eficiente y sencillo del equipo, con menor necesidad de intervención del operador.",
    text: "",
    bg: "#00840d",
    textColor: "#ffffff",
  },
  {
    title:
      "Equipos auxiliares y componentes sobredimensionados y de gran volumen, permitiendo operaciones a gran escala, con total estabilidad, continuas, intensivas y prolongadas, sin paros, con mínima intervención del operador",
    text: "",
    bg: "#6b97c6",
    textColor: "#ffffff",
  },
];
---

<Layout title="Tambor de contraflujo">
  <div class="">
    <HeroComponentV1
      title="TAMBOR DE CONTRAFLUJO PRO+"
      text="Para contratistas experimentados que buscan la mejor planta de asfalto, con la mayor producción y nivel de exigencias técnicas incomparables, capaz de adaptarse a cualquier proyecto, incluso con diferentes tipos de mezcla. Ideal para una operación ecológica evitando multas y paros costosos por contaminación, con el consumo de combustible más bajo en el mercado y mayor porcentaje de incorporación de RAP, hasta un 50%."
      heroImage={hero2.src}
      btns={true}
      bgColor="#1e1e1e"
      titleColor="#ffffff"
      textColor="#ffffff"
    >
      <div class="flex flex-row justify-center items-center gap-10">
        <a
          class="font-thin text-white text-xl lg:text-2xl"
          href="/TamborMezcla/Contraflujo/ContraDesamaq">Desamaq</a
        >
        <a
          class="font-thin text-white text-xl lg:text-2xl"
          href="/TamborMezcla/Contraflujo/ContraPlus">Plus</a
        >
        <a
          class="underline font-bold text-white text-xl lg:text-2xl"
          href="/DrumMixers">Pro +</a
        >
      </div>
    </HeroComponentV1>
  </div>

  <OdometerDrum client:only />

  <div>
    <DropdownComponent
      title="LA PLANTA DE ASFALTO MÁS ROBUSTA, MODERNA Y EQUIPADA DE LATINOAMÉRICA ES MEXICANA"
    >
      <p>
        Ofrecemos la solución más avanzada para la producción continua de mezcla
        asfáltica, con tambores mezcladores de alto desempeño que integran
        secado, mezclado, captura de finos en la casa de bolsas y su
        reincorporación en un solo chasis diseñado para trabajo pesado. Nuestro
        diseño está orientado a máxima eficiencia térmica, una operación
        continua, eficiente y con mayor control del proceso, garantizando
        eficiencia operativa, tranquilidad de su cliente, durabilidad del
        pavimento en cualquier proyecto y producción constante sin paros.
      </p>
    </DropdownComponent>
  </div>
  <OsDrumSection />

  <div class="bg-[#1e1e1e] flex flex-col justify-center items-center px-8">
    <div class="flex flex-col justify-center items-center">
      <h1
        class="text-white font-bold text-xl md:text-3xl text-center lg:text-start md:text-start"
      >
        Para evitar desperdicios, robos y mala operación de su planta de asfalto
      </h1>
      <p
        class="text-white text-center lg:text-start md:text-start text-sm md:text-base"
      >
        Paro total con un solo botón desde su celular
      </p>
    </div>
    <div class="flex items-center justify-center">
      <a
        href="/Relief"
        aria-label="View page drum Mixers"
        class="text-white text-center mb-5 mt-5 text-xs md:text-sm font-normal border-2 border-[#14427c] rounded-full py-2 px-6 transition-all duration-300 ease-out transform hover:scale-110 hover:shadow-lg bg-[#14427c] hover:bg-white hover:text-black hover:border-white"
      >
        Ver más
      </a>
    </div>
  </div>

  <div class="mt-5 md:mt-14">
    <StackedInfoCards
      cards={cards}
      mainTitle="Su mejor negocio comienza con nosotros"
      mainDescription="Los contratistas que nos conocen prefieren Triaso sobre otras marcas por nuestra alta calidad, confiabilidad y precios."
    />
  </div>

  <HotspotSection />

  <div class="max-w-7xl mx-auto">
    <SliderTamborCom />
  </div>

  <QuemadorSeccion />

  <BolsasSeccion />

  <DrumMixPlanos client:only />

  <UltimaSeccion />
  <!-- <OneSection /> -->
  <!-- <StationarySection />
    <IntegratedBaghouses /> -->
  <!-- <CardSection /> -->
  <!-- <CardSectionResponsive /> -->
</Layout>
