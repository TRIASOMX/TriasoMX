---
import Layout from "../layouts/Layout.astro";
import LearnBtn from "../components/unitComponents/LearnBtn.astro";

const quickLinks = [
  { text: "Plantas de asfalto", href: "/plantas-asfalto" },
  { text: "Trituradoras", href: "/trituradoras-videos" },
  { text: "Nosotros", href: "/nosotros" },
  { text: "Refacciones", href: "/refacciones" },
];
---

<Layout
  title="Página no encontrada | TRIASO"
  description="La página que buscas no existe o fue movida. Vuelve al inicio para conocer las plantas de asfalto y equipos de TRIASO."
  noindex
>
  <section
    class="relative overflow-hidden bg-bgMain min-h-[70vh] flex items-center justify-center px-4 py-20"
  >
    <div
      class="rlf-grid absolute inset-0 opacity-60 pointer-events-none"
      style="mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 flex flex-col items-center text-center max-w-2xl">
      <p class="text-sm font-semibold text-redBg">Error 404</p>

      <p
        class="mt-2 font-bold leading-none text-blueMain text-8xl md:text-[10rem]"
        aria-hidden="true"
      >
        4<span class="text-redBg">0</span>4
      </p>

      <h1 class="mt-6 text-2xl md:text-4xl font-bold text-grisT">
        Esta página no existe
      </h1>
      <p class="mt-3 text-base md:text-lg text-grisP">
        Es posible que el enlace esté roto o que la página se haya movido.
      </p>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-4">
        <LearnBtn text="Volver al inicio" href="/" label="Volver al inicio" />
        <LearnBtn
          text="Contáctanos"
          href="/contacto"
          label="Ir a la página de contacto"
          className="bg-transparent !border-blueMain !text-blueMain hover:bg-blueMain hover:!text-white"
        />
      </div>

      <nav class="mt-10" aria-label="Enlaces sugeridos">
        <p class="text-sm text-grisP">O visita alguna de estas secciones:</p>
        <ul class="mt-3 flex flex-wrap justify-center gap-x-6 gap-y-2">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm md:text-base font-semibold text-blueMain hover:text-redBg transition-colors duration-300"
                >
                  {link.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</Layout>
