---
import Layout from "../layouts/Layout.astro";
import CMIntroSection from "../components/ColdMix/CMIntroSection.astro";
import CMCards from "../components/ColdMix/CMCards.astro";
import CMTab from "../components/ColdMix/CMTab";
import CMPugMill from "../components/ColdMix/CMPugMill.astro";
import CMSidePanels from "../components/ColdMix/CMSidePanels.astro";
import CMPlanos from "../components/ColdMix/CMPlanos";
import CTASection1 from "../components/unitComponents/CTASection1.astro";
import GallerySlider from "../components/unitComponents/GallerySlider";
import cmg1 from "../assets/images/ColdMix/GallerySlider/CMG1.webp";
import cmg2 from "../assets/images/ColdMix/GallerySlider/CMG2.webp";
import cmg3 from "../assets/images/ColdMix/GallerySlider/CMG3.webp";
import cmg4 from "../assets/images/ColdMix/GallerySlider/CMG4.webp";
import cmg5 from "../assets/images/ColdMix/GallerySlider/CMG5.webp";
import cmg6 from "../assets/images/ColdMix/GallerySlider/CMG6.webp";
import cmg7 from "../assets/images/ColdMix/GallerySlider/CMG7.webp";
import cmg8 from "../assets/images/ColdMix/GallerySlider/CMG8.webp";

const coldMixCaption =
  "Planta mezcladora en frío, estabilizadora, de hasta 200 Tmph, con descarga en piso";

const coldMixSlides = [
  { image: cmg1.src, caption: coldMixCaption },
  { image: cmg2.src, caption: coldMixCaption },
  { image: cmg3.src, caption: coldMixCaption },
  { image: cmg4.src, caption: coldMixCaption },
  { image: cmg5.src, caption: coldMixCaption },
  { image: cmg6.src, caption: coldMixCaption },
  { image: cmg7.src, caption: coldMixCaption },
  { image: cmg8.src, caption: coldMixCaption },
];
---

<Layout title="ColdMix Page">
  <CMIntroSection />
  <CMCards />

  <CMSidePanels />
  <section class="bg-[#14427c]">
    <div class="max-w-7xl mx-auto px-8 py-10">
      <h1 class="font-bold text-white text-xl md:text-3xl text-center">
        Venda a mejor precio que la competencia, atraiga
      </h1>
      <h1 class="font-bold text-white text-xl md:text-3xl text-center">
        más clientes, y obtenga mayores ganancias
      </h1>
    </div>

    <CMTab client:only />
  </section>

  <CTASection1 />
  <CMPugMill />
  <section>
    <GallerySlider client:visible slides={coldMixSlides} />
  </section>
  <CMPlanos client:only />
</Layout>
