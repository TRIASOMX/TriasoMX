---
import Layout from "../layouts/Layout.astro";
import VideoGallery from "../components/unitComponents/VideoGallery.tsx";
import { videosRock } from "../assets/data/videosTrituradorasData.js";
---

<Layout title="Crusher Videos">
  <section class="w-full flex justify-center">
    <div class="w-full max-w-7xl pt-24 px-6 md:px-8">
      <h1 class="text-2xl md:text-4xl font-bold text-grisT">
        TRITURADORAS — VIDEOS
      </h1>
      <p class="mt-4 max-w-3xl text-base md:text-lg text-grisPPP">
        Trenes de trituración en operación: quebradoras de quijada, conos,
        cribas y circuitos cerrados con alimentadores y colectores de polvo.
        Cada video muestra un equipo real fabricado por TRIASO. Haz clic en
        cualquier miniatura para reproducirlo.
      </p>
    </div>
  </section>
  <VideoGallery videos={videosRock} client:load />
</Layout>
