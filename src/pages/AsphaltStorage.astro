---
import Layout from "../layouts/Layout.astro";
import HeroImg from "../assets/images/AsphaltStorage/SliderStorage/P-3a.webp";
import FirstSection from "../components/AsphaltStorage/FirstSection.astro";
import ASModals from "../components/AsphaltStorage/ASModals.astro";
import ASHoses from "../components/AsphaltStorage/ASHoses.astro";
import ASTabs from "../components/AsphaltStorage/ASTabs.astro";
import ASPlanos from "../components/AsphaltStorage/ASPlanos";
import ASOdometer from "../components/AsphaltStorage/ASOdometer";
import Slider from "../components/AsphaltStorage/Slider";
import img1 from "../assets/images/AsphaltStorage/sedenaBG.jpg";
import img2 from "../assets/images/AsphaltStorage/Low/versatil.webp";
import img3 from "../assets/images/AsphaltStorage/Calentamiento.webp";
import img4 from "../assets/images/AsphaltStorage/Versatilidad.webp";
import HeroComponentV1 from "../components/unitComponents/HeroComponentV1.astro";
const slides = [
  {
    id: 1,
    title: "Almacenamiento de calidad",
    text: "Diseñamos tanques con la misión de ofrecer versatilidad y confiabilidad en el almacenamiento de asfalto, desde pavimentación de carreteras hasta impermeabilización y otros usos de gran escala.",
    image: img2.src,
  },
  {
    id: 2,
    title: "Sistema de calentamiento",
    text: "Equipados con sistemas de calentamiento eficientes y control preciso de temperatura, mantienen la consistencia requerida del asfalto tanto para ligantes estándar como modificados.",
    image: img3.src,
  },
  {
    id: 3,
    title: "Tanques de almacenamiento de asfalto SEDENA",
    text: "En 2024, la Secretaría de la Defensa Nacional (SEDENA) adquirió 18 tanques de almacenamiento Triaso, para apoyar los trabajos nacionales de pavimentación e infraestructura.",
    image: img1.src,
  },
  {
    id: 4,
    title: "Versatilidad total",
    text: "Para requerimientos especiales, ya sea que necesite una solución estándar o un diseño a la medida.",
    image: img4.src,
  },
  {
    id: 5,
    title: "Sistemas portátiles y reubicables",
    text: "Diseñados para facilitar el transporte y una instalación rápida, nuestros sistemas ofrecen operación consistente y confiable en cualquier sitio de trabajo — ideales para proyectos temporales o que se reubican con frecuencia.",
    image: "https://placehold.co/600x400/png",
  },
  {
    id: 6,
    title: "Fabricación resistente",
    text: "Nuestros tanques de almacenamiento de asfalto están fabricados con materiales resistentes al desgaste, diseñados para soportar condiciones abrasivas y de trabajo pesado. Esta construcción robusta garantiza un desempeño confiable incluso en los entornos más exigentes. Al reducir significativamente el desgaste, el diseño disminuye las necesidades de mantenimiento y extiende la vida útil del sistema, ofreciendo una solución confiable a largo plazo.",
    image: "https://placehold.co/600x400/png",
  },
];
---

<Layout
  title="Asphalt Storage"
  description="Information about asphalt storage facilities and regulations."
>
  <HeroComponentV1
    title="Tanques de almacenamiento de asfalto Triaso®"
    text="Los tanques de asfalto Triaso® están diseñados para almacenar y mantener el asfalto en condiciones óptimas, asegurando una calidad y un desempeño constantes. Fabricados con materiales de alta resistencia y aislamiento de alta eficiencia, mantienen el asfalto listo para usarse en cualquier aplicación. Ideales para la producción de asfalto modificado con polímeros, estos tanques ofrecen la durabilidad y funcionalidad necesarias tanto para proyectos pequeños como para operaciones de gran escala."
    heroImage={HeroImg.src}
  />

  <div class="w-full h-auto md:h-[100vh] flex justify-center items-center">
    <ASOdometer client:only />
  </div>

  <br />
  <h2 class="text-center text-[#14427c] font-bold text-2xl md:text-3xl mb-10">
    Eficiencia térmica que reduce el consumo de combustible.
  </h2>
  <Slider slides={slides} client:only /><br />
  <h2
    class="text-center text-[#c11b1b] font-bold text-2xl md:text-3xl mb-10 max-w-[70ch] mx-auto"
  >
    Con Triaso, conviértase en el proveedor principal de asfalto para todos los
    proyectos de pavimentación en su zona.
  </h2>
  <FirstSection />
  <ASModals />
  <ASHoses />
  <ASTabs />
  <ASPlanos client:only />
  <!-- <CardSection /> -->
  <!-- <CardSectionResponsive /> -->
</Layout>
