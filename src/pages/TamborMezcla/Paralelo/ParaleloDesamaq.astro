---
import Layout from "../../../layouts/Layout.astro";
import OdometerFlujo from "../../../components/DrumMixers/OdometerFlujo";
import HeroComponentV1 from "../../../components/unitComponents/HeroComponentV1.astro";
import DropdownComponent from "../../../components/unitComponents/DropdownComponent.astro";
import StackedInfoCards from "../../../components/unitComponents/StackedInfoCards.astro";
import HotspotSection from "../../../components/DrumMixers/Paralelo/Desamaq/HotspotSection.astro";
import QuemadorSeccion from "../../../components/DrumMixers/Paralelo/Desamaq/QuemadorSeccion.astro";
import LavadoraSeccion from "../../../components/DrumMixers/LavadoraSeccion.astro";
import UltimaSeccion from "../../../components/DrumMixers/UltimaSeccion.astro";
import Hero2 from "../../../assets/images/DrumMixers/FlujoParalelo/Desamaq/FDesamac.webp";
import SliderTamborCom from "../../../components/DrumMixers/Contraflujo/Desamaq/SliderTambores.astro";
import PDPlanos from "../../../components/DrumMixers/Paralelo/Desamaq/PDPlanos";

const cards = [
  {
    title:
      "La planta de asfalto de contraflujo más productiva al menor de Latinoamérica",
    text: "",
    bg: "#d13c3c",
    textColor: "#ffffff",
  },
  {
    title:
      "Solución práctica y eficiente para quienes buscan una operación confiaable y económica.",
    text: "",
    bg: "#14427c",
    textColor: "#ffffff",
  },
  {
    title:
      "Operación total manual para un control eficiente y sencillo del equipo.",
    text: "",
    bg: "#00840d",
    textColor: "#ffffff",
  },
  {
    title:
      "Operación estable y continua sin paros, a gran escala, con una configuración ideal para trabajo pesado y condiciones variables.",
    text: "",
    bg: "#6b97c6",
    textColor: "#ffffff",
  },
];
---

<Layout title="Tambor de Paralelo Desamaq">
  <div class="">
    <HeroComponentV1
      title="Tambor de Paralelo Desamaq"
      text="Para contratistas que están iniciando con proyectos pequeños y buscan no depender de otros productores de mezcla, evitando paros costosas, con bajo consumo de combustible ofreciendo una excelente relación costo-beneficio en su categoría."
      heroImage={Hero2.src}
      btns={true}
      bgColor="#14427c"
      textColor="white"
      titleColor="white"
    >
      <div class="flex flex-row justify-center items-center gap-10">
        <a
          class="font-bold underline text-white text-xl lg:text-2xl"
          href="/TamborMezcla/Paralelo/ParaleloDesamaq">Desamaq</a
        >
        <a
          class="font-thin text-white text-xl lg:text-2xl"
          href="/TamborMezcla/Paralelo/ParaleloPlus">Plus</a
        >
        <a
          class="font-thin text-white text-xl lg:text-2xl"
          href="/TamborMezcla/Paralelo/ParaleloPro">Pro +</a
        >
      </div>
    </HeroComponentV1>
  </div>

  <OdometerFlujo client:only />

  <div>
    <DropdownComponent
      title="LA PLANTA DE ASFALTO MÁS PRODUCTIVA AL MENOR PRECIO DE LATINOAMERICA ES MEXICANA"
    >
      <div class="space-y-5">
        <p>
          Ofrecemos la solución más avanzada para la producción continua de
          mezcla asfáltica, con tambores mezcladores de alto desempeño que
          integran secado, mezclado, captura de finos en la lavadora y su
          desecho en fosas de lodos. Nuestro diseño está orientado a máxima
          eficiencia térmica, una operación continua, eficiente y con mayor
          control del proceso, garantizando eficiencia operativa, tranquilidad
          de su cliente, durabilidad del pavimento en cualquier proyecto y
          producción constante sin paros.
        </p>
      </div>
    </DropdownComponent>
  </div>
  <!-- <OsDrumSection />

    <div class="bg-[#1e1e1e] flex flex-col justify-center items-center px-8">
        <div class="flex flex-col justify-center items-center pb-10">
            <h1
                class="text-white font-bold text-3xl text-center lg:text-start md:text-start"
            >
                Para evitar desperdicios, robos y mala operación de su planta de
                asfalto
            </h1>
            <p class="text-white text-center lg:text-start md:text-start">
                Paro total con un solo botón desde su celular
            </p>
        </div>
    </div> -->

  <div class="mt-5">
    <StackedInfoCards
      cards={cards}
      mainTitle="Su mejor negocio comienza con nosotros"
      mainDescription="Los contratistas que nos conocen prefieren Triaso sobre otras marcas por nuestra alta calidad, confiabilidad y precios."
    />
  </div>

  <HotspotSection />

  <div class="max-w-7xl mx-auto px-8">
    <SliderTamborCom />
  </div>

  <QuemadorSeccion />

  <LavadoraSeccion />

  <PDPlanos client:only />

  <UltimaSeccion />
</Layout>
