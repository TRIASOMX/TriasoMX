---
import Layout from "../../../layouts/Layout.astro";
import OdometerFlujo from "../../../components/DrumMixers/Paralelo/Plus/fpPlusOdometer";
import HeroComponentV1 from "../../../components/unitComponents/HeroComponentV1.astro";
import DropdownComponent from "../../../components/unitComponents/DropdownComponent.astro";
import OsDrumSection from "../../../components/DrumMixers/OsDrumSection.astro";
import StackedInfoCards from "../../../components/unitComponents/StackedInfoCards.astro";
import HotspotSection from "../../../components/DrumMixers/Paralelo/Plus/HotspotSection.astro";
import QuemadorSeccion from "../../../components/DrumMixers/Paralelo/Plus/QuemadorSeccion.astro";
import LavadoraSeccion from "../../../components/DrumMixers/LavadoraSeccion.astro";
import UltimaSeccion from "../../../components/DrumMixers/UltimaSeccion.astro";
import HeroImage2 from "../../../assets/images/DrumMixers/FlujoParalelo/Plus/FPlus.webp";
import SliderTamborCom from "../../../components/DrumMixers/Paralelo/Plus/SliderTamborFPlus.astro";
import FPPlusPlanos from "../../../components/DrumMixers/Paralelo/Plus/FPPlusPlanos";
import LearnBtnBlue from "../../../components/unitComponents/LearnBtnBlue.astro";

const cards = [
  {
    title:
      "La planta de asfalto de flujoparalelo más robusta, más moderna de Latinoamérica.",
    text: "",
    bg: "#d13c3c",
    textColor: "#ffffff",
  },
  {
    title:
      "Solución práctica y eficiente para quienes buscan una operación confiable con una inversión más accesible",
    text: "",
    bg: "#14427c",
    textColor: "#ffffff",
  },
  {
    title:
      "Operación total manual o automática para un control eficiente y sencillo del equipo, con menor necesidad de intervención del operador.",
    text: "",
    bg: "#00840d",
    textColor: "#ffffff",
  },
  {
    title:
      "Operación estable, continua, intensiva y prolongada sin paros, a escala, con una configuración ideal para trabajo pesado y condiciones variables, la planta está completamente equipada.",
    text: "",
    bg: "#6b97c6",
    textColor: "#ffffff",
  },
];
---

<Layout title="Tambor de Paralelo Plus">
  <div class="">
    <HeroComponentV1
      title="Tambor de Flujo paralelo Plus"
      text="Para contratistas experimentados que buscan una planta con producción y nivel de exigencias técnicas superiores, capaz de adaptarse a cualquier proyecto, incluso con diferentes tipos de mezcla. Evitando paros costosos, con bajo consumo de combustible ofreciendo una excelente relación costo-beneficio en su categoría."
      heroImage={HeroImage2.src}
      btns={true}
    >
      <div class="flex flex-row justify-center items-center gap-10">
        <a
          class="font-thin text-black text-xl lg:text-2xl"
          href="/TamborMezcla/Paralelo/ParaleloDesamaq">Desamaq</a
        >
        <a
          class="font-bold underline text-black text-xl lg:text-2xl"
          href="/TamborMezcla/Paralelo/ParaleloPlus">Plus</a
        >
        <a
          class="font-thin text-black text-xl lg:text-2xl"
          href="/TamborMezcla/Paralelo/ParaleloPro">Pro +</a
        >
      </div>
    </HeroComponentV1>
  </div>

  <OdometerFlujo client:only />

  <div>
    <DropdownComponent
      title="LA PLANTA DE ASFALTO MÁS ROBUSTA Y MODERNA DE LATINOAMÉRICA ES MEXICANA"
    >
      <div class="space-y-5">
        <p>
          Ofrecemos la solución más avanzada para la producción continua de
          mezcla asfáltica, con tambores mezcladores de alto desempeño que
          integran secado, mezclado, captura de finos en la lavadora y su
          desecho en fosas de lodos. Nuestro diseño está orientado a máxima
          eficiencia térmica, una operación continua, eficiente y con mayor
          control del proceso, garantizando eficiencia operativa, tranquilidad
          de su cliente, durabilidad del pavimento en cualquier proyecto y
          producción constante sin paros.
        </p>
      </div>
    </DropdownComponent>
  </div>
  <OsDrumSection />

  <div class="bg-[#1e1e1e] flex flex-col justify-center items-center px-8">
    <div class="flex flex-col justify-center items-center pb-10">
      <h1
        class="text-white font-bold text-xl md:text-3xl text-center lg:text-start md:text-start"
      >
        Para evitar desperdicios, robos y mala operación de su planta de asfalto
      </h1>
      <p class="text-white text-center lg:text-start md:text-start">
        Paro total con un solo botón desde su celular
      </p><br />
      <LearnBtnBlue />
    </div>
  </div>

  <div class="mt-5">
    <StackedInfoCards
      cards={cards}
      mainTitle="Su mejor negocio comienza con nosotros"
      mainDescription="Los contratistas que nos conocen prefieren Triaso sobre otras marcas por nuestra alta calidad, confiabilidad y precios."
    />
  </div>

  <HotspotSection />

  <div class="max-w-7xl mx-auto px-8">
    <SliderTamborCom />
  </div>

  <QuemadorSeccion />

  <LavadoraSeccion />

  <FPPlusPlanos client:only />

  <UltimaSeccion />
</Layout>
