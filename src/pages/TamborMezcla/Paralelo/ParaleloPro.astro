---
import Layout from "../../../layouts/Layout.astro";
import OdometroFPro from "../../../components/DrumMixers/Paralelo/Pro+/OdometroFPro";
import FPProPlanos from "../../../components/DrumMixers/Paralelo/Pro+/FPProPlanos";
import HeroComponentV1 from "../../../components/unitComponents/HeroComponentV1.astro";
import DropdownComponent from "../../../components/unitComponents/DropdownComponent.astro";
import OsDrumSection from "../../../components/DrumMixers/OsDrumSection.astro";
import StackedInfoCards from "../../../components/unitComponents/StackedInfoCards.astro";
import HotspotSection from "../../../components/DrumMixers/Paralelo/Pro+/HotspotSection.astro";
import QuemadorSeccion from "../../../components/DrumMixers/Paralelo/Plus/QuemadorSeccion.astro";
import LavadoraSeccion from "../../../components/DrumMixers/LavadoraSeccion.astro";
import hero2 from "../../../assets/images/DrumMixers/FlujoParalelo/Pro/FPpro.webp";
import SliderParalelo from "../../../components/DrumMixers/Paralelo/Pro+/SliderTamborFPro.astro";
import UltimaSeccion from "../../../components/DrumMixers/UltimaSeccion.astro";
import LearnBtnBlue from "../../../components/unitComponents/LearnBtnBlue.astro";
import ElevadorRetractilSection from "../../../components/unitComponents/ElevadorRetractilSection.astro";

const cards = [
  {
    title:
      "La planta de asfalto de contraflujo más equipada, más robusta, más moderna de Latinoamérica.",
    text: "",
    bg: "#d13c3c",
    textColor: "#ffffff",
  },
  {
    title:
      "Con una configuración ideal para trabajo pesado y condiciones cariables la planta de asfalto está completamente equipada.",
    text: "",
    bg: "#14427c",
    textColor: "#ffffff",
  },
  {
    title:
      "Operación total manual o automática para un control eficiente y sencillo del equipo, con menor necesidad de intervención del operador.",
    text: "",
    bg: "#00840d",
    textColor: "#ffffff",
  },
  {
    title:
      "Equipos auxiliares y componentes sobredimensionados y de gran volumen, permitiendo operaciones a gran escala, con total estabilidad, continuas, intensivas y prolongadas, sin paros, con mínima intervención del operador",
    text: "",
    bg: "#6b97c6",
    textColor: "#ffffff",
  },
];
---

<Layout title="Tambor de contraflujo">
  <div class="">
    <HeroComponentV1
      title="Tambor de Flujo paralelo Pro+"
      text="Para contratistas experimentados que buscan la mejor planta de asfalto de flujo paralelo, con la mayor producción y alto nivel técnico. Apta para cualquier proyecto, incluso con diferentes tipos de mezcla. Evitando paros costosos y con el consumo de combustible más bajo en el mercado."
      heroImage={hero2.src}
      bgColor="#1e1e1e"
      textColor="white"
      titleColor="white"
      btns={true}
    >
      <div class="flex flex-row justify-center items-center gap-10">
        <a
          class="font-thin text-white text-xl lg:text-2xl"
          href="/TamborMezcla/Paralelo/ParaleloDesamaq">Desamaq</a
        >
        <a
          class="font-thin text-white text-xl lg:text-2xl"
          href="/TamborMezcla/Paralelo/ParaleloPlus">Plus</a
        >
        <a
          class="font-bold underline text-white text-xl lg:text-2xl"
          href="/TamborMezcla/Paralelo/ParaleloPro">Pro +</a
        >
      </div>
    </HeroComponentV1>
  </div>

  <OdometroFPro client:only />

  <div>
    <DropdownComponent
      title="LA PLANTA DE ASFALTO MÁS ROBUSTA, MODERNA Y EQUIPADA DE LATINOAMÉRICA ES MEXICANA"
    >
      <p>
        Ofrecemos la solución más avanzada para la producción continua de mezcla
        asfáltica, con tambores mezcladores de alto desempeño que integran
        secado, mezclado, captura de finos en la lavadora y su desecho en fosas
        de lodos. Nuestro diseño está orientado a máxima eficiencia térmica, una
        operación continua, eficiente y con mayor control del proceso,
        garantizando eficiencia operativa, tranquilidad de su cliente,
        durabilidad del pavimento en cualquier proyecto y producción constante
        sin paros.
      </p>
    </DropdownComponent>
  </div>
  <OsDrumSection />

  <div class="bg-[#1e1e1e] flex flex-col justify-center items-center px-8">
    <div class="flex flex-col justify-center items-center pb-10">
      <h1
        class="text-white font-bold text-3xl text-center lg:text-start md:text-start"
      >
        Para evitar desperdicios, robos y mala operación de su planta de asfalto
      </h1>
      <p class="text-white text-center lg:text-start md:text-start">
        Paro total con un solo botón desde su celular
      </p><br />
      <LearnBtnBlue />
    </div>
  </div>

  <div class="mt-5">
    <StackedInfoCards
      cards={cards}
      mainTitle="Su mejor negocio comienza con nosotros"
      mainDescription="Los contratistas que nos conocen prefieren Triaso sobre otras marcas por nuestra alta calidad, confiabilidad y precios."
    />
  </div>

  <HotspotSection />

  <div class="max-w-7xl mx-auto px-8">
    <SliderParalelo />
  </div>
  <section class="w-full flex justify-center items-center">
    <ElevadorRetractilSection />
  </section>
  <QuemadorSeccion />

  <LavadoraSeccion />

  <FPProPlanos client:only />

  <UltimaSeccion />
</Layout>
