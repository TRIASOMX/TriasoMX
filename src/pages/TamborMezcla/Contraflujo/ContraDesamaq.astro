---
import Layout from "../../../layouts/Layout.astro";
import OdometerDesamaq from "../../../components/DrumMixers/Contraflujo/Desamaq/OdometerDesamaq";

import DropdownComponent from "../../../components/unitComponents/DropdownComponent.astro";
import StackedInfoCards from "../../../components/unitComponents/StackedInfoCards.astro";
import QuemadorSeccion from "../../../components/DrumMixers/Contraflujo/Desamaq/QuemadorSeccion.astro";
import BolsasSeccion from "../../../components/DrumMixers/Contraflujo/Desamaq/BolsasSeccion.astro";
import hero2 from "../../../assets/images/DrumMixers/Contraflujo/CDesamac.webp";
import HotspotSectionContra from "../../../components/DrumMixers/Contraflujo/Desamaq/HotspotSection.astro";
import UltimaSeccion from "../../../components/DrumMixers/UltimaSeccion.astro";

import PlanosCf from "../../../components/DrumMixers/Contraflujo/Desamaq/PlanosCf";
import SliderTamborCom from "../../../components/DrumMixers/Contraflujo/Desamaq/SliderTambores.astro";

import HeroComponentV1 from "../../../components/unitComponents/HeroComponentV1.astro";

const cards = [
  {
    title:
      "La planta de asfalto de contraflujo más productiva al menor precio de Latinoamérica",
    text: "",
    bg: "#e7e6da",
    textColor: "#000000",
  },
  {
    title:
      "Solución práctica y eficiente para quienes buscan una operación confiable con una inversión completamente económica.",
    text: "",
    bg: "#14427c",
    textColor: "#ffffff",
  },
  {
    title:
      "Operación total manual para un control eficiente y sencillo del equipo.",
    text: "",
    bg: "#00840d",
    textColor: "#ffffff",
  },
  {
    title:
      "Operación estable y continua sin paros, a gran escala, con una configuración ideal para trabajo pesado y condiciones variables.",
    text: "",
    bg: "#6b97c6",
    textColor: "#ffffff",
  },
];
---

<Layout title="Tambor de contraflujo">
  <div class="">
    <HeroComponentV1
      title="Tambor de Contraflujo Desamaq"
      text="Para contratistas que están iniciando y buscan no depender de otros productores de mezcla. Ideal para una operación ecológica evitando multas y paros costosos por contaminación, con bajo consumo de combustible ofreciendo una excelente relación costo-beneficio en su categoría."
      heroImage={hero2}
      btns={true}
      bgColor="#14427c"
      textColor="#ffffff"
      titleColor="#ffffff"
    >
      <div class="max-w-7xl mx-auto px-8">
        <div class="flex flex-row justify-center items-center gap-10">
          <a
            class="underline font-bold text-white text-xl lg:text-2xl"
            href="/TamborMezcla/Contraflujo/ContraDesamaq">Desamaq</a
          >
          <a
            class="font-thin text-white text-xl lg:text-2xl"
            href="/TamborMezcla/Contraflujo/ContraPlus">Plus</a
          >
          <a class="font-thin text-white text-xl lg:text-2xl" href="/DrumMixers"
            >Pro +</a
          >
        </div>
      </div>
    </HeroComponentV1>
  </div>

  <OdometerDesamaq client:only />

  <div>
    <DropdownComponent
      title="LA PLANTA DE ASFALTO MÁS MODERNA DE LATINOAMÉRICA ES MEXICANA"
    >
      <div class="space-y-5">
        <p>
          Ofrecemos una solución práctica y confiable para la producción
          continua de mezcla asfáltica, con tambores mezcladores que integran
          secado, mezclado, captura de finos en la casa de bolsas y su
          reincorporación en un solo chasis diseñado para trabajo pesado, con
          opción de tolvas montadas o independientes. Este diseño está orientado
          a una operación estable, garantizando eficiencia operativa,
          tranquilidad de su cliente y durabilidad del pavimento en cualquier
          proyecto.
        </p>
      </div>
    </DropdownComponent>
  </div>

  <!-- <OsDrumSection />

    <div class="bg-[#1e1e1e] flex flex-col justify-center items-center px-8">
        <div class="flex flex-col justify-center items-center pb-10">
            <h1
                class="text-white font-bold text-3xl text-center lg:text-start md:text-start"
            >
                Para evitar desperdicios, robos y mala operación de su planta de
                asfalto
            </h1>
            <p class="text-white text-center lg:text-start md:text-start">
                Paro total con un solo botón desde su celular
            </p>
        </div>
    </div> -->

  <div class="mt-5">
    <StackedInfoCards
      cards={cards}
      mainTitle="Su mejor negocio comienza con nosotros"
      mainDescription="Los contratistas que nos conocen prefieren Triaso sobre otras marcas por nuestra alta calidad, confiabilidad y precios."
    />
  </div>

  <HotspotSectionContra />

  <div class="max-w-7xl mx-auto px-8">
    <SliderTamborCom />
  </div>

  <QuemadorSeccion />

  <BolsasSeccion />

  <PlanosCf client:only />

  <UltimaSeccion />
</Layout>
